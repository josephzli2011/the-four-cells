---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import PeriodicTable from '../../../components/islands/PeriodicTable.astro';
import TriangleQuiz from '../../../components/islands/TriangleQuiz.astro';
import MarsExplorer from '../../../components/islands/MarsExplorer.astro';
import { courses } from '../../../data/site';

export function getStaticPaths() {
  return courses.flatMap((course) =>
    course.lessons.map((lesson) => ({
      params: { course: course.slug, lesson: lesson.slug },
      props: { course, lesson },
    }))
  );
}

const { course, lesson } = Astro.props;

const siblings = course.lessons.filter((l) => l.slug !== lesson.slug);

// Source credit carried over from the original page.
const credit =
  lesson.island === 'mars'
    ? 'Source: NASA Visualization Technology Applications and Development (VTAD)'
    : null;
---

<Base title={lesson.title} description={lesson.blurb}>
  <section class="lesson-head">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/courses">Courses</a>
        <span aria-hidden="true">/</span>
        <a href={`/courses/${course.slug}`}>{course.title}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{lesson.title}</span>
      </nav>

      <div class="head-main">
        <span class="tag">{lesson.kind}</span>
        <h1>{lesson.title}</h1>
        <p class="lede">{lesson.blurb}</p>
      </div>
    </div>
  </section>

  <section class="stage">
    <div class="container">
      {lesson.island === 'periodic-table' && <PeriodicTable />}
      {lesson.island === 'triangle-quiz' && <TriangleQuiz />}
      {lesson.island === 'mars' && <MarsExplorer />}

      {credit && <p class="credit">{credit}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="next">
        {
          siblings.length > 0 ? (
            <div class="next-block">
              <p class="next-head">Next in {course.title}</p>
              <ul role="list">
                {siblings.map((l) => (
                  <li>
                    <a href={`/courses/${course.slug}/${l.slug}`}>
                      <span class="next-kind">{l.kind}</span>
                      <span class="next-title">{l.title}</span>
                      <Icon name="arrow" size={16} class="btn-arrow" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <div class="next-block">
              <p class="next-head">Keep going</p>
              <ul role="list">
                <li>
                  <a href={`/courses/${course.slug}`}>
                    <span class="next-kind">{course.group}</span>
                    <span class="next-title">All of {course.title}</span>
                    <Icon name="arrow" size={16} class="btn-arrow" />
                  </a>
                </li>
              </ul>
            </div>
          )
        }

        <aside class="contribute">
          <Icon name="spark" size={20} />
          <div>
            <h2>Spotted a mistake?</h2>
            <p>
              These lessons are written by students and we'd rather know. Send a
              correction and we'll fix it.
            </p>
            <a href="/about#contact" class="contribute-link">
              Get in touch <Icon name="arrow" size={15} class="btn-arrow" />
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .lesson-head { padding-block: clamp(2rem, 5vw, 3.5rem) var(--sp-6); }

  .crumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-faint);
    margin-bottom: var(--sp-5);
  }

  .crumbs a { color: var(--text-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); text-decoration: underline; }

  .head-main h1 {
    font-size: var(--fs-3xl);
    font-weight: 500;
    margin-block: var(--sp-3) var(--sp-4);
  }

  .lede {
    max-width: 62ch;
    font-size: var(--fs-lg);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .stage { padding-bottom: var(--sp-7); }

  .credit {
    margin-top: var(--sp-4);
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .next {
    display: grid;
    gap: var(--sp-5);
    align-items: start;
  }

  @media (min-width: 880px) {
    .next { grid-template-columns: 1.4fr 1fr; }
  }

  .next-head {
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: var(--sp-4);
  }

  .next-block ul { display: grid; gap: var(--sp-2); }

  .next-block a {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }

  .next-block a:hover { border-color: var(--accent); }

  .next-kind {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
  }

  .next-title { font-size: var(--fs-sm); }

  .next-block :global(.btn-arrow) {
    margin-left: auto;
    color: var(--accent);
    flex-shrink: 0;
    transition: transform var(--dur) var(--ease);
  }

  .next-block a:hover :global(.btn-arrow) { transform: translateX(3px); }

  .contribute {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-5);
    border-radius: var(--r-lg);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--accent);
  }

  .contribute h2 { font-size: var(--fs-lg); font-weight: 500; color: var(--text); }

  .contribute p {
    margin-block: var(--sp-2) var(--sp-3);
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .contribute-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .contribute-link :global(.btn-arrow) { transition: transform var(--dur) var(--ease); }
  .contribute-link:hover :global(.btn-arrow) { transform: translateX(3px); }
</style>
