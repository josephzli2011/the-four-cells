  }

  @keyframes mx-rotate {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-200px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mx-surface {
      animation: none;
    }
  }

  .mx-hotspot {
    position: absolute;
    left: var(--hx);
    top: var(--hy);
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2em 0.5em 0.2em 0.2em;
