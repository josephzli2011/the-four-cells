interface CategoryMeta {
  id: Category;
  label: string;
  /** Short label for narrow legend chips */
  short: string;
}

const CATEGORIES: CategoryMeta[] = [
  { id: 'alkali', label: 'Alkali metal', short: 'Alkali' },
  { id: 'alkaline', label: 'Alkaline earth metal', short: 'Alk. earth' },
  { id: 'transition', label: 'Transition metal', short: 'Transition' },
  { id: 'posttransition', label: 'Post-transition metal', short: 'Post-trans.' },
  { id: 'metalloid', label: 'Metalloid', short: 'Metalloid' },
  { id: 'nonmetal', label: 'Reactive nonmetal', short: 'Nonmetal' },
  { id: 'halogen', label: 'Halogen', short: 'Halogen' },
  { id: 'noble', label: 'Noble gas', short: 'Noble gas' },
  { id: 'lanthanide', label: 'Lanthanide', short: 'Lanthanide' },
  { id: 'actinide', label: 'Actinide', short: 'Actinide' },
];

const CATEGORY_LABEL: Record<Category, string> = Object.fromEntries(
  CATEGORIES.map((c) => [c.id, c.label]),
) as Record<Category, string>;

const PHASE_LABEL: Record<Phase, string> = {
  solid: 'Solid',
  liquid: 'Liquid',
  gas: 'Gas',
  unknown: 'Unknown',
};

/* ------------------------------------------------------------------
   Grid geometry.
   Column 1 is the period-number gutter, so an element in IUPAC group g
   sits in grid column g + 1. Row 1 is the group-number header, so period
   p sits in grid row p + 1. Row 9 is the gap, and the detached
   lanthanide / actinide rows are rows 10 and 11.
   ------------------------------------------------------------------ */
const F_BLOCK_COL_OFFSET = 4; // La / Ac start under group 3

function gridX(el: ChemicalElement): number {
  if (el.cat === 'lanthanide') return el.z - 57 + F_BLOCK_COL_OFFSET;
  if (el.cat === 'actinide') return el.z - 89 + F_BLOCK_COL_OFFSET;
  return (el.group ?? 1) + 1;
}

function gridY(el: ChemicalElement): number {
  if (el.cat === 'lanthanide') return 10;
  if (el.cat === 'actinide') return 11;
  return el.period + 1;
}

const placed = ELEMENTS.map((el) => ({ el, x: gridX(el), y: gridY(el) }));

const GROUPS = Array.from({ length: 18 }, (_, i) => i + 1);
const PERIODS = Array.from({ length: 7 }, (_, i) => i + 1);

const fmtTemp = (k: number | null): string =>
  k === null ? 'Unknown' : `${k} K · ${Math.round(k - 273.15)} °C`;

const uid = `pt-${Math.random().toString(36).slice(2, 9)}`;
const panelId = `${uid}-panel`;
const titleId = `${uid}-panel-title`;
const searchId = `${uid}-search`;
const tempId = `${uid}-temp`;
---

<section
  class="ptbl"
  data-ptbl
  data-view="category"
  aria-labelledby={`${uid}-heading`}
>
  <h2 id={`${uid}-heading`} class="visually-hidden">Interactive periodic table</h2>

  <!-- ── Controls ─────────────────────────────────────────────── -->
  <div class="ptbl-toolbar">
    <div class="ptbl-search">
      <label class="visually-hidden" for={searchId}>
        Search elements by name, symbol or atomic number
      </label>
      <svg
        class="ptbl-search-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m20 20-4.8-4.8"></path>
      </svg>
      <input
        id={searchId}
        class="ptbl-search-input"
        type="search"
        inputmode="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search name, symbol or number…"
        data-ptbl-search
      />
      <button class="ptbl-clear" type="button" data-ptbl-clear hidden>
        <span class="visually-hidden">Clear search</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <div class="ptbl-views" role="group" aria-label="Colour the table by">
      <button
        class="ptbl-view-btn is-on"
        type="button"
        data-ptbl-view="category"
        aria-pressed="true"
      >Category</button>
      <button
        class="ptbl-view-btn"
        type="button"
        data-ptbl-view="temp"
        aria-pressed="false"
      >Temperature</button>
    </div>
  </div>

  <!-- ── Temperature scrubber (only meaningful in the temp view) ── -->
  <div class="ptbl-temp" data-ptbl-tempbar hidden>
    <div class="ptbl-temp-head">
      <label class="ptbl-temp-label" for={tempId}>Temperature</label>
      <output class="ptbl-temp-out" for={tempId} data-ptbl-tempout>298 K · 25 °C</output>
    </div>
    <input
      id={tempId}
      class="ptbl-temp-range"
      type="range"
      min="1"
      max="6000"
      step="1"
      value="298"
      data-ptbl-temprange
    />
    <div class="ptbl-temp-foot">
      <div class="ptbl-presets" role="group" aria-label="Temperature presets">
        <button type="button" class="ptbl-preset" data-ptbl-preset="4">4 K</button>
        <button type="button" class="ptbl-preset" data-ptbl-preset="77">77 K</button>
        <button type="button" class="ptbl-preset" data-ptbl-preset="298">298 K</button>
        <button type="button" class="ptbl-preset" data-ptbl-preset="1000">1000 K</button>
        <button type="button" class="ptbl-preset" data-ptbl-preset="3000">3000 K</button>
      </div>
      <p class="ptbl-tally" data-ptbl-tally></p>
    </div>
  </div>

  <!-- ── Legend / category filter ──────────────────────────────── -->
  <div class="ptbl-legend" role="group" aria-label="Filter by element category">
    {
      CATEGORIES.map((c) => (
        <button
          class="ptbl-chip"
          type="button"
          data-ptbl-cat={c.id}
          data-cat={c.id}
          aria-pressed="false"
        >
          <span class="ptbl-chip-key" aria-hidden="true" />
          <span class="ptbl-chip-full">{c.label}</span>
          <span class="ptbl-chip-short" aria-hidden="true">{c.short}</span>
        </button>
      ))
    }
    <button class="ptbl-chip ptbl-chip-reset" type="button" data-ptbl-reset hidden>
      Show all
    </button>
  </div>

  <!-- ── The table ─────────────────────────────────────────────── -->
  <div class="ptbl-scroller" data-ptbl-scroller>
    <div
      class="ptbl-grid"
      data-ptbl-grid
      role="group"
      aria-label="Periodic table of the elements, 118 elements arranged by group and period"
    >
      {
        GROUPS.map((g) => (
          <div class="ptbl-axis ptbl-axis-col" style={`--x:${g + 1};--y:1`} aria-hidden="true">
            {g}
          </div>
        ))
      }
      {
        PERIODS.map((p) => (
          <div class="ptbl-axis ptbl-axis-row" style={`--x:1;--y:${p + 1}`} aria-hidden="true">
            {p}
          </div>
        ))
      }

      <div class="ptbl-marker" style="--x:4;--y:7" aria-hidden="true">57–71</div>
      <div class="ptbl-marker" style="--x:4;--y:8" aria-hidden="true">89–103</div>

      <div class="ptbl-fband" style="--x:2;--y:10" aria-hidden="true">Lanthanides</div>
      <div class="ptbl-fband" style="--x:2;--y:11" aria-hidden="true">Actinides</div>

      {
        placed.map(({ el, x, y }, i) => (
          <button
            class="ptbl-cell"
            type="button"
            style={`--x:${x};--y:${y}`}
            data-cat={el.cat}
            data-z={el.z}
            data-x={x}
            data-y={y}
            data-sym={el.sym}
            data-name={el.name}
            data-mass={el.mass}
            data-catlabel={CATEGORY_LABEL[el.cat]}
            data-group={el.group === null ? 'f-block' : String(el.group)}
            data-period={el.period}
            data-cfg={el.cfg}
            data-en={el.en === null ? '' : String(el.en)}
            data-phase={el.phase}
            data-phaselabel={PHASE_LABEL[el.phase]}
            data-melt={el.melt === null ? '' : String(el.melt)}
            data-boil={el.boil === null ? '' : String(el.boil)}
            data-melttext={fmtTemp(el.melt)}
            data-boiltext={fmtTemp(el.boil)}
            data-shells={el.shells.join(',')}
            data-desc={el.desc}
            data-search={`${el.name} ${el.sym} ${el.z}`.toLowerCase()}
            tabindex={i === 0 ? 0 : -1}
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-label={`${el.name}, symbol ${el.sym}, atomic number ${el.z}, ${CATEGORY_LABEL[el.cat]}`}
          >
            <span class="ptbl-z" aria-hidden="true">{el.z}</span>
            <span class="ptbl-sym" aria-hidden="true">{el.sym}</span>
            <span class="ptbl-name" aria-hidden="true">{el.name}</span>
            <span class="ptbl-mass" aria-hidden="true">{el.mass}</span>
          </button>
        ))
      }
    </div>
  </div>

  <p class="ptbl-hint" data-ptbl-hint aria-hidden="true">
    Swipe the table sideways to see every group →
  </p>

  <p class="visually-hidden" role="status" aria-live="polite" data-ptbl-status></p>

  <!-- ── Detail panel ──────────────────────────────────────────── -->
  <div class="ptbl-scrim" data-ptbl-scrim hidden></div>

  <aside
    id={panelId}
    class="ptbl-panel"
    data-ptbl-panel
    role="dialog"
    aria-modal="false"
    aria-labelledby={titleId}
    data-open="false"
  >
    <button class="ptbl-panel-close" type="button" data-ptbl-close>
      <span class="visually-hidden">Close element details</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>

    <div class="ptbl-panel-scroll">
      <div class="ptbl-panel-head">
        <div class="ptbl-tile" data-ptbl-tile data-cat="nonmetal" aria-hidden="true">
          <span class="ptbl-tile-z" data-f="tileZ">1</span>
          <span class="ptbl-tile-sym" data-f="tileSym">H</span>
          <span class="ptbl-tile-mass" data-f="tileMass">1.008</span>
        </div>
        <div class="ptbl-panel-titles">
          <h3 class="ptbl-panel-title" id={titleId} data-f="name" tabindex="-1">Hydrogen</h3>
          <p class="ptbl-panel-cat" data-f="catlabel">Reactive nonmetal</p>
          <p class="ptbl-panel-desc" data-f="desc"></p>
        </div>
      </div>

      <dl class="ptbl-props">
        <div class="ptbl-prop"><dt>Atomic number</dt><dd data-f="z">—</dd></div>
        <div class="ptbl-prop"><dt>Atomic mass</dt><dd data-f="mass">—</dd></div>
        <div class="ptbl-prop"><dt>Group</dt><dd data-f="group">—</dd></div>
        <div class="ptbl-prop"><dt>Period</dt><dd data-f="period">—</dd></div>
        <div class="ptbl-prop ptbl-prop-wide"><dt>Electron configuration</dt><dd data-f="cfg">—</dd></div>
        <div class="ptbl-prop"><dt>Electronegativity</dt><dd data-f="en">—</dd></div>
        <div class="ptbl-prop"><dt>Phase at STP</dt><dd data-f="phase">—</dd></div>
        <div class="ptbl-prop"><dt>Melting point</dt><dd data-f="melt">—</dd></div>
        <div class="ptbl-prop"><dt>Boiling point</dt><dd data-f="boil">—</dd></div>
      </dl>

      <div class="ptbl-shell">
        <h4 class="ptbl-shell-title">Electron shells</h4>
        <div class="ptbl-shell-art" data-ptbl-shellart></div>
        <p class="ptbl-shell-counts" data-f="shellcounts">—</p>
      </div>
    </div>
  </aside>
</section>

<style>
  /* ============================================================
     Category palette. Every swatch pairs a tinted surface with a
     same-hue ink at ≥ 7:1 contrast, in both themes.
     ============================================================ */
  .ptbl {
    --cat-alkali-bg: hsl(4 86% 93%);
    --cat-alkali-fg: hsl(4 66% 28%);
    --cat-alkali-key: hsl(4 76% 52%);

    --cat-alkaline-bg: hsl(28 92% 91%);
    --cat-alkaline-fg: hsl(24 76% 25%);
    --cat-alkaline-key: hsl(28 84% 47%);

    --cat-transition-bg: hsl(228 100% 93%);
    --cat-transition-fg: hsl(233 74% 33%);
    --cat-transition-key: hsl(232 92% 58%);

    --cat-posttransition-bg: hsl(188 70% 89%);
    --cat-posttransition-fg: hsl(193 78% 21%);
    --cat-posttransition-key: hsl(190 72% 36%);

    --cat-metalloid-bg: hsl(96 58% 88%);
    --cat-metalloid-fg: hsl(99 64% 20%);
    --cat-metalloid-key: hsl(97 52% 35%);

    --cat-nonmetal-bg: hsl(152 62% 89%);
    --cat-nonmetal-fg: hsl(155 66% 20%);
    --cat-nonmetal-key: hsl(154 60% 34%);

    --cat-halogen-bg: hsl(46 94% 87%);
    --cat-halogen-fg: hsl(38 82% 23%);
    --cat-halogen-key: hsl(42 88% 43%);

    --cat-noble-bg: hsl(328 92% 93%);
    --cat-noble-fg: hsl(332 66% 30%);
    --cat-noble-key: hsl(330 74% 52%);

    --cat-lanthanide-bg: hsl(258 92% 94%);
    --cat-lanthanide-fg: hsl(262 62% 35%);
    --cat-lanthanide-key: hsl(260 72% 58%);

    --cat-actinide-bg: hsl(290 78% 93%);
    --cat-actinide-fg: hsl(292 60% 31%);
    --cat-actinide-key: hsl(292 62% 48%);

    /* Phase palette for the temperature view */
    --ph-solid-bg: hsl(215 32% 90%);
    --ph-solid-fg: hsl(216 44% 25%);
    --ph-solid-key: hsl(215 30% 48%);

    --ph-liquid-bg: hsl(200 88% 88%);
    --ph-liquid-fg: hsl(205 82% 22%);
