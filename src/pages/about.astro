---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { brand, issues, courses } from '../data/site';

// Contributors derived from published work — no invented roster.
const contributors = [...new Set(issues.flatMap((i) => i.authors))].sort();

const values = [
  {
    icon: 'spark',
    title: 'Taught by people who just learned it',
    body: "Our writers are students. They remember exactly which part was confusing, because they were confused by it last semester.",
  },
  {
    icon: 'book',
    title: 'Free, permanently',
    body: 'No paywall, no account, no trial. Every article, quiz, and interactive module is open to anyone with a browser.',
  },
  {
    icon: 'quiz',
    title: 'Built to be used, not just read',
    body: 'Where a diagram beats a paragraph, we build the diagram — and make it something you can actually manipulate.',
  },
];
---

<Base title="About" description={brand.mission}>
  <section class="page-head">
    <div class="container container-narrow">
      <p class="eyebrow"><Icon name="cell" size={14} /> About</p>
      <h1>Who we are</h1>
      <p class="lede">{brand.mission}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul role="list" class="values">
        {
          values.map((v, i) => (
            <li class="value" data-reveal style={`--reveal-delay:${Math.min(i * 70, 150)}ms`}>
              <span class="value-icon">
                <Icon name={v.icon} size={22} />
              </span>
              <h2>{v.title}</h2>
              <p>{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="stats">
        <div><dt>Subjects</dt><dd>{courses.length}</dd></div>
        <div><dt>Published works</dt><dd>{issues.length}</dd></div>
        <div><dt>Contributors</dt><dd>{contributors.length}</dd></div>
        <div><dt>Price</dt><dd>Free</dd></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="sec-title">Contributors</h2>
      <p class="sec-sub">Students whose work appears in our published issues.</p>

      <ul role="list" class="people">
        {
          contributors.map((name, i) => (
            <li class="person" data-reveal style={`--reveal-delay:${Math.min(i * 60, 150)}ms`}>
              <span class="avatar" aria-hidden="true">
                {name
                  .split(' ')
                  .map((n) => n[0])
                  .join('')}
              </span>
              <span class="person-name">{name}</span>
              <span class="person-work">
                {issues.filter((x) => x.authors.includes(name)).length} published
              </span>
            </li>
          ))
        }
      </ul>

      <p class="roster-note">
        <Icon name="spark" size={15} />
        The full team roster from the previous site is still being migrated.
      </p>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <div class="contact">
        <div>
          <h2>Get in touch</h2>
          <p>
            Questions, corrections, or want to write for us? We read everything that
            comes in.
          </p>
        </div>
        <div class="contact-actions">
          <a href="/submit" class="btn">
            Submit an Article
            <Icon name="arrow" size={17} class="btn-arrow" />
          </a>
          <a href="/csad" class="btn btn-secondary">
            <Icon name="quiz" size={17} />
            CSAD™ Tutoring
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(2.5rem, 6vw, 5rem) 0; }

  .page-head h1 {
    font-size: var(--fs-3xl);
    font-weight: 500;
    margin-block: var(--sp-3) var(--sp-4);
  }

  .lede { font-size: var(--fs-lg); color: var(--text-muted); line-height: 1.75; }

  .values {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  }

  .value {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    padding: var(--sp-6);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .value-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--r-md);
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .value h2 { font-size: var(--fs-lg); font-weight: 500; }
  .value p { font-size: var(--fs-sm); line-height: 1.7; color: var(--text-muted); }

  .alt { background: var(--bg-subtle); }

  .stats {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    text-align: center;
  }

  .stats dt {
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .stats dd {
    font-size: var(--fs-2xl);
    font-weight: 500;
    color: var(--accent);
    margin-top: var(--sp-2);
  }

  .sec-title { font-size: var(--fs-xl); font-weight: 500; }
  .sec-sub { color: var(--text-muted); margin-block: var(--sp-2) var(--sp-5); }

  .people {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }

  .person {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--r-full);
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .person-name { font-size: var(--fs-sm); font-weight: 500; }

  .person-work {
    margin-left: auto;
    font-size: var(--fs-xs);
    color: var(--text-faint);
    white-space: nowrap;
  }

  .roster-note {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
    border: 1px dashed var(--border-strong);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: var(--sp-7);
    border-radius: var(--r-lg);
    background: linear-gradient(140deg, var(--brand), var(--blue-700));
    color: var(--text-on-brand);
  }

  .contact h2 { font-size: var(--fs-2xl); font-weight: 500; }

  .contact p {
    margin-top: var(--sp-2);
    color: color-mix(in srgb, var(--text-on-brand) 88%, transparent);
    max-width: 46ch;
  }

  .contact-actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }

  .contact .btn {
    --btn-bg: var(--text-on-brand);
    --btn-fg: var(--brand);
  }

  .contact .btn:hover { --btn-bg: var(--off-white); }

  .contact .btn-secondary {
    --btn-bg: transparent;
    --btn-fg: var(--text-on-brand);
    border-color: color-mix(in srgb, var(--text-on-brand) 45%, transparent);
  }

  .contact .btn-secondary:hover {
    --btn-bg: color-mix(in srgb, var(--text-on-brand) 14%, transparent);
    --btn-fg: var(--text-on-brand);
  }
</style>
