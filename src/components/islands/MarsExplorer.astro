    font-weight: 500;
    margin-bottom: var(--sp-3);
  }

  .mx-bar-row {
    display: grid;
    grid-template-columns: 3.4em 1fr auto;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-2);
  }

  .mx-bar-tag {
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  .mx-bar-tag--earth {
    color: var(--mx-earth-ocean);
  }

  .mx-bar-tag--mars {
    color: var(--mx-rust-700);
  }

  :global([data-theme='dark']) .mx-bar-tag--earth,
  :global([data-theme='dark']) .mx-bar-tag--mars {
