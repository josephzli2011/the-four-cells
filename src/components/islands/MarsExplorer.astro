  }

  .mx-scale-sub {
    text-anchor: middle;
    font-size: 10px;
    fill: var(--text-faint);
  }

  .mx-compare-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: var(--sp-5);
  }

  .mx-slider-label {
    display: block;
    font-size: var(--fs-sm);
    font-weight: 500;
    margin-bottom: var(--sp-2);
  }

  #mx-metric-slider {
    width: 100%;
    accent-color: var(--accent);
  }

  .mx-slider-ticks {
    display: flex;
    justify-content: space-between;
