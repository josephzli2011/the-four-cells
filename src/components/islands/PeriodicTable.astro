    --ph-gas-key: hsl(27 86% 62%);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .ptbl {
      --cat-alkali-bg: hsl(4 44% 21%);
      --cat-alkali-fg: hsl(6 92% 86%);
      --cat-alkali-key: hsl(4 82% 66%);

      --cat-alkaline-bg: hsl(26 46% 20%);
      --cat-alkaline-fg: hsl(30 94% 84%);
      --cat-alkaline-key: hsl(28 86% 62%);

      --cat-transition-bg: hsl(232 44% 26%);
      --cat-transition-fg: hsl(230 100% 88%);
      --cat-transition-key: hsl(232 100% 74%);

      --cat-posttransition-bg: hsl(191 46% 19%);
      --cat-posttransition-fg: hsl(188 88% 82%);
      --cat-posttransition-key: hsl(190 76% 58%);

      --cat-metalloid-bg: hsl(98 38% 18%);
      --cat-metalloid-fg: hsl(94 74% 82%);
      --cat-metalloid-key: hsl(97 56% 56%);

      --cat-nonmetal-bg: hsl(154 42% 17%);
      --cat-nonmetal-fg: hsl(150 76% 82%);
      --cat-nonmetal-key: hsl(153 60% 52%);

      --cat-halogen-bg: hsl(41 48% 19%);
      --cat-halogen-fg: hsl(46 94% 80%);
      --cat-halogen-key: hsl(44 88% 60%);

      --cat-noble-bg: hsl(330 42% 22%);
      --cat-noble-fg: hsl(330 94% 88%);
      --cat-noble-key: hsl(330 84% 70%);

      --cat-lanthanide-bg: hsl(260 42% 26%);
      --cat-lanthanide-fg: hsl(262 96% 89%);
      --cat-lanthanide-key: hsl(260 88% 74%);

      --cat-actinide-bg: hsl(292 38% 24%);
      --cat-actinide-fg: hsl(295 90% 89%);
      --cat-actinide-key: hsl(293 74% 70%);

      --ph-solid-bg: hsl(216 26% 22%);
      --ph-solid-fg: hsl(212 48% 86%);
      --ph-solid-key: hsl(214 32% 62%);

      --ph-liquid-bg: hsl(202 56% 20%);
      --ph-liquid-fg: hsl(198 90% 82%);
      --ph-liquid-key: hsl(200 80% 60%);

      --ph-gas-bg: hsl(24 54% 21%);
      --ph-gas-fg: hsl(30 94% 82%);
      --ph-gas-key: hsl(27 86% 62%);
    }
  }

  /* Resolve the active swatch once, then everything reads --sw-* */
  .ptbl [data-cat='alkali'] { --sw-bg: var(--cat-alkali-bg); --sw-fg: var(--cat-alkali-fg); --sw-key: var(--cat-alkali-key); }
  .ptbl [data-cat='alkaline'] { --sw-bg: var(--cat-alkaline-bg); --sw-fg: var(--cat-alkaline-fg); --sw-key: var(--cat-alkaline-key); }
  .ptbl [data-cat='transition'] { --sw-bg: var(--cat-transition-bg); --sw-fg: var(--cat-transition-fg); --sw-key: var(--cat-transition-key); }
  .ptbl [data-cat='posttransition'] { --sw-bg: var(--cat-posttransition-bg); --sw-fg: var(--cat-posttransition-fg); --sw-key: var(--cat-posttransition-key); }
  .ptbl [data-cat='metalloid'] { --sw-bg: var(--cat-metalloid-bg); --sw-fg: var(--cat-metalloid-fg); --sw-key: var(--cat-metalloid-key); }
  .ptbl [data-cat='nonmetal'] { --sw-bg: var(--cat-nonmetal-bg); --sw-fg: var(--cat-nonmetal-fg); --sw-key: var(--cat-nonmetal-key); }
  .ptbl [data-cat='halogen'] { --sw-bg: var(--cat-halogen-bg); --sw-fg: var(--cat-halogen-fg); --sw-key: var(--cat-halogen-key); }
  .ptbl [data-cat='noble'] { --sw-bg: var(--cat-noble-bg); --sw-fg: var(--cat-noble-fg); --sw-key: var(--cat-noble-key); }
  .ptbl [data-cat='lanthanide'] { --sw-bg: var(--cat-lanthanide-bg); --sw-fg: var(--cat-lanthanide-fg); --sw-key: var(--cat-lanthanide-key); }
  .ptbl [data-cat='actinide'] { --sw-bg: var(--cat-actinide-bg); --sw-fg: var(--cat-actinide-fg); --sw-key: var(--cat-actinide-key); }

  /* Temperature view overrides the swatch with the computed phase */
  .ptbl[data-view='temp'] .ptbl-cell[data-ph='solid'] { --sw-bg: var(--ph-solid-bg); --sw-fg: var(--ph-solid-fg); --sw-key: var(--ph-solid-key); }
  .ptbl[data-view='temp'] .ptbl-cell[data-ph='liquid'] { --sw-bg: var(--ph-liquid-bg); --sw-fg: var(--ph-liquid-fg); --sw-key: var(--ph-liquid-key); }
  .ptbl[data-view='temp'] .ptbl-cell[data-ph='gas'] { --sw-bg: var(--ph-gas-bg); --sw-fg: var(--ph-gas-fg); --sw-key: var(--ph-gas-key); }
  .ptbl[data-view='temp'] .ptbl-cell[data-ph='unknown'] { --sw-bg: var(--ph-unknown-bg); --sw-fg: var(--ph-unknown-fg); --sw-key: var(--ph-unknown-key); }

  /* ============================================================
     Toolbar
     ============================================================ */
  .ptbl-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .ptbl-search {
    position: relative;
    flex: 1 1 15rem;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .ptbl-search-icon {
    position: absolute;
    left: 0.85rem;
    width: 18px;
    height: 18px;
    color: var(--text-faint);
    pointer-events: none;
  }

  .ptbl-search-input {
    width: 100%;
    padding: 0.7em 2.4rem 0.7em 2.6rem;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface);
    font-size: var(--fs-sm);
    font-weight: 400;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .ptbl-search-input::-webkit-search-cancel-button {
    display: none;
  }

  .ptbl-search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }

  .ptbl-search-input::placeholder {
    color: var(--text-faint);
  }

  .ptbl-clear {
    position: absolute;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: var(--r-full);
    color: var(--text-muted);
    transition: background-color var(--dur-fast) var(--ease);
  }

  .ptbl-clear:hover {
    background: var(--bg-sunken);
    color: var(--text);
  }

  .ptbl-clear svg {
    width: 14px;
    height: 14px;
  }

  .ptbl-views {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--bg-subtle);
  }

  .ptbl-view-btn {
    padding: 0.45em 1em;
    border-radius: var(--r-full);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-muted);
    transition: background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .ptbl-view-btn:hover {
    color: var(--text);
  }

  .ptbl-view-btn.is-on {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  /* ============================================================
     Temperature scrubber
     ============================================================ */
  .ptbl-temp {
    margin-bottom: var(--sp-4);
    padding: var(--sp-3) var(--sp-4) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
  }

  .ptbl-temp[hidden] {
    display: none;
  }

  .ptbl-temp-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-1);
  }

  .ptbl-temp-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ptbl-temp-out {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .ptbl-temp-range {
    width: 100%;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .ptbl-temp-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
  }

  .ptbl-presets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }

  .ptbl-preset {
    padding: 0.25em 0.7em;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    transition: border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .ptbl-preset:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .ptbl-tally {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ============================================================
     Legend / filter chips
     ============================================================ */
  .ptbl-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-4);
  }

  .ptbl-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.3em 0.8em;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface);
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--text-muted);
    transition: border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .ptbl-chip:hover {
    color: var(--text);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .ptbl-chip[aria-pressed='true'] {
    background: var(--sw-bg);
    color: var(--sw-fg);
    border-color: var(--sw-key);
    font-weight: 500;
  }

  .ptbl-chip-key {
    width: 0.66em;
    height: 0.66em;
    border-radius: var(--r-xs);
    background: var(--sw-key);
    flex-shrink: 0;
  }

  .ptbl-chip-short {
    display: none;
  }

  .ptbl-chip-reset {
    color: var(--accent);
    border-color: var(--accent-border);
    background: var(--accent-subtle);
  }

  .ptbl-chip-reset[hidden] {
    display: none;
  }

  @media (max-width: 560px) {
    .ptbl-chip-full {
      display: none;
    }
    .ptbl-chip-short {
      display: inline;
    }
  }

  /* ============================================================
     Grid
     ============================================================ */
  .ptbl-scroller {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: var(--sp-2);
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }

  .ptbl-grid {
    display: grid;
    grid-template-columns: var(--axis) repeat(18, var(--cell));
    grid-template-rows:
      calc(var(--cell) * 0.42)
      repeat(7, var(--cell))
      var(--sp-4)
      repeat(2, var(--cell));
    gap: var(--gap);
    width: max-content;
    margin-inline: auto;
    padding: 2px;
  }

  .ptbl-axis {
    grid-column: var(--x);
    grid-row: var(--y);
    display: grid;
    place-items: center;
    font-size: calc(var(--cell) * 0.19);
    font-weight: 500;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-fast) var(--ease);
  }

  .ptbl-axis.is-axis {
    color: var(--accent);
  }

  .ptbl-marker,
  .ptbl-fband {
    grid-column: var(--x);
    grid-row: var(--y);
    display: grid;
    place-items: center;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-xs);
    background: var(--bg-subtle);
    font-size: calc(var(--cell) * 0.17);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .ptbl-fband {
    grid-column: var(--x) / span 2;
    border: none;
    background: none;
    justify-items: end;
    padding-right: 0.4em;
    text-align: right;
    font-size: calc(var(--cell) * 0.16);
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .ptbl-cell {
    grid-column: var(--x);
    grid-row: var(--y);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: calc(var(--cell) * 0.04);
    border: 1px solid transparent;
    border-radius: var(--r-xs);
    background: var(--sw-bg);
    color: var(--sw-fg);
    overflow: hidden;
    text-align: center;
    line-height: 1.05;
    transition: transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease), opacity var(--dur) var(--ease),
      filter var(--dur) var(--ease), background-color var(--dur) var(--ease),
      color var(--dur) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .ptbl-z {
    position: absolute;
    top: calc(var(--cell) * 0.045);
    left: calc(var(--cell) * 0.08);
    font-size: calc(var(--cell) * 0.19);
    font-weight: 500;
    opacity: 0.72;
    font-variant-numeric: tabular-nums;
  }

  .ptbl-sym {
    font-size: calc(var(--cell) * 0.35);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: calc(var(--cell) * 0.1);
  }

  .ptbl-name {
    max-width: 100%;
    margin-top: calc(var(--cell) * 0.03);
    font-size: calc(var(--cell) * 0.145);
    font-weight: 400;
    opacity: 0.85;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ptbl-mass {
    font-size: calc(var(--cell) * 0.135);
    opacity: 0.62;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .ptbl-mass {
      display: none;
    }
  }

  /* — states — */
  .ptbl-cell:hover,
  .ptbl-cell:focus-visible {
    transform: translateY(-3px) scale(1.04);
    box-shadow: var(--shadow-md);
    border-color: var(--sw-key);
    z-index: 3;
  }

  .ptbl-cell:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .ptbl-cell.is-axis {
    box-shadow: inset 0 0 0 1px var(--sw-key);
    z-index: 1;
  }

  .ptbl-cell.is-dim {
    opacity: 0.16;
    filter: grayscale(0.9);
  }

  .ptbl-cell.is-dim:hover {
    opacity: 0.45;
    transform: none;
    box-shadow: none;
  }

  .ptbl-cell.is-selected {
    z-index: 4;
    border-color: var(--text);
    box-shadow: 0 0 0 2px var(--text), var(--shadow-md);
  }

  /* ============================================================
     Scroll hint
     ============================================================ */
  .ptbl-hint {
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--text-faint);
    text-align: center;
    transition: opacity var(--dur) var(--ease);
  }

  .ptbl-hint.is-gone {
    opacity: 0;
  }

  @media (min-width: 960px) {
    .ptbl-hint {
      display: none;
    }
  }

  /* ============================================================
     Detail panel — side panel on desktop, bottom sheet on mobile
     ============================================================ */
  .ptbl-scrim {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: hsl(240 20% 6% / 0.5);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .ptbl-scrim.is-on {
    opacity: 1;
  }

  .ptbl-scrim[hidden] {
    display: none;
  }

  @media (min-width: 900px) {
    .ptbl-scrim {
      display: none;
    }
  }

  .ptbl-panel {
    position: fixed;
    z-index: 50;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease),
      visibility var(--dur) var(--ease);
  }

  .ptbl-panel[data-open='false'] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* bottom sheet */
  @media (max-width: 899px) {
    .ptbl-panel {
      left: 0;
      right: 0;
      bottom: 0;
      max-height: min(80vh, 640px);
      border-radius: var(--r-lg) var(--r-lg) 0 0;
      border-bottom: none;
    }

    .ptbl-panel[data-open='false'] {
      transform: translateY(100%);
    }
  }

  /* side panel */
  @media (min-width: 900px) {
    .ptbl-panel {
      top: calc(var(--header-h) + var(--sp-4));
      right: var(--sp-4);
      width: min(26rem, 34vw);
      max-height: calc(100vh - var(--header-h) - var(--sp-6));
      border-radius: var(--r-lg);
    }

    .ptbl-panel[data-open='false'] {
      transform: translateX(calc(100% + var(--sp-5)));
    }
  }

  .ptbl-panel-scroll {
    max-height: inherit;
    overflow-y: auto;
    padding: var(--sp-5) var(--sp-5) var(--sp-6);
    overscroll-behavior: contain;
  }

  @media (max-width: 899px) {
    .ptbl-panel-scroll {
      max-height: min(80vh, 640px);
      padding-bottom: calc(var(--sp-6) + env(safe-area-inset-bottom, 0px));
    }
  }

  .ptbl-panel-close {
    position: absolute;
    top: var(--sp-3);
    right: var(--sp-3);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-full);
    background: var(--bg-subtle);
    color: var(--text-muted);
    transition: background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .ptbl-panel-close:hover {
    background: var(--bg-sunken);
    color: var(--text);
  }

  .ptbl-panel-close svg {
    width: 15px;
    height: 15px;
  }

  .ptbl-panel-head {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    padding-right: var(--sp-6);
  }

  .ptbl-tile {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: var(--r-md);
    background: var(--sw-bg);
    color: var(--sw-fg);
    box-shadow: inset 0 0 0 1px var(--sw-key);
    line-height: 1.1;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .ptbl-tile-z {
    font-size: var(--fs-xs);
    font-weight: 500;
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }

  .ptbl-tile-sym {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .ptbl-tile-mass {
    font-size: var(--fs-xs);
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .ptbl-panel-titles {
    min-width: 0;
  }

  .ptbl-panel-title {
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: var(--ls-tight);
  }

  .ptbl-panel-title:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  .ptbl-panel-cat {
    margin-top: 0.15em;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--sw-key);
  }

  .ptbl-panel-desc {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .ptbl-props {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-2) var(--sp-3);
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
  }

  .ptbl-prop-wide {
    grid-column: 1 / -1;
  }

  .ptbl-prop dt {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    letter-spacing: 0.01em;
  }

  .ptbl-prop dd {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text);
    line-height: 1.35;
  }

  .ptbl-shell {
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
  }

  .ptbl-shell-title {
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .ptbl-shell-art {
    display: grid;
    place-items: center;
    margin-top: var(--sp-2);
  }

  .ptbl-shell-art :global(svg) {
    width: min(210px, 100%);
    height: auto;
  }

  .ptbl-shell-art :global(.sd-ring) {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .ptbl-shell-art :global(.sd-nucleus) {
    fill: var(--sw-key);
  }

  .ptbl-shell-art :global(.sd-nucleus-text) {
    fill: var(--bg);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .ptbl-shell-art :global(.sd-e) {
    fill: var(--sw-key);
  }

  .ptbl-shell-counts {
    margin-top: var(--sp-2);
    text-align: center;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ============================================================
     Motion preferences
     ============================================================ */
  @media (prefers-reduced-motion: reduce) {
    .ptbl-cell,
    .ptbl-chip,
    .ptbl-panel,
    .ptbl-scrim,
    .ptbl-hint {
      transition: none;
    }

    .ptbl-cell:hover,
    .ptbl-cell:focus-visible {
      transform: none;
    }

    .ptbl-chip:hover {
      transform: none;
    }

    .ptbl-panel[data-open='false'] {
      transform: none;
    }
  }
</style>

<script>
  type Phase = 'solid' | 'liquid' | 'gas' | 'unknown';

  interface Cell {
    el: HTMLButtonElement;
    z: number;
    x: number;
    y: number;
    cat: string;
    search: string;
    melt: number | null;
    boil: number | null;
  }

  const toNum = (v: string | undefined): number | null => {
    if (!v) return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : null;
  };

  /**
   * Phase of an element at temperature `t` (K). Elements whose boiling point
   * sits below their melting point (arsenic, and carbon at 1 atm) sublime, so
   * the boiling point is treated as a solid → gas transition.
   */
  function phaseAt(melt: number | null, boil: number | null, t: number): Phase {
    if (melt === null && boil === null) return 'unknown';
    if (melt !== null && boil !== null && boil <= melt) {
      return t < boil ? 'solid' : 'gas';
    }
    if (melt !== null && t < melt) return 'solid';
    if (boil !== null && t >= boil) return 'gas';
    if (melt === null) return 'unknown';
    return 'liquid';
  }

  const SVG_NS = 'http://www.w3.org/2000/svg';

  /** Bohr-style shell diagram built from the shell occupancy numbers. */
  function shellDiagram(shells: number[], z: number, name: string): SVGSVGElement {
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', '0 0 200 200');
    svg.setAttribute('role', 'img');
    svg.setAttribute(
      'aria-label',
      `Electron shell diagram for ${name}: ${shells.join(', ')} electrons from the innermost shell outwards.`,
    );

    const cx = 100;
    const cy = 100;
    const n = shells.length;
    const inner = 30;
    const outer = 92;
    const step = n > 1 ? (outer - inner) / (n - 1) : 0;

    shells.forEach((count, i) => {
      const r = n > 1 ? inner + i * step : 52;

      const ring = document.createElementNS(SVG_NS, 'circle');
      ring.setAttribute('class', 'sd-ring');
      ring.setAttribute('cx', String(cx));
      ring.setAttribute('cy', String(cy));
      ring.setAttribute('r', r.toFixed(2));
      svg.appendChild(ring);

      const dot = count <= 8 ? 3.4 : count <= 18 ? 2.6 : 1.9;
      const offset = i * 0.28;

      for (let k = 0; k < count; k += 1) {
        const theta = -Math.PI / 2 + (2 * Math.PI * k) / count + offset;
        const e = document.createElementNS(SVG_NS, 'circle');
        e.setAttribute('class', 'sd-e');
        e.setAttribute('cx', (cx + r * Math.cos(theta)).toFixed(2));
        e.setAttribute('cy', (cy + r * Math.sin(theta)).toFixed(2));
        e.setAttribute('r', String(dot));
        svg.appendChild(e);
      }
    });

    const nucleus = document.createElementNS(SVG_NS, 'circle');
    nucleus.setAttribute('class', 'sd-nucleus');
    nucleus.setAttribute('cx', String(cx));
    nucleus.setAttribute('cy', String(cy));
    nucleus.setAttribute('r', '14');
    svg.appendChild(nucleus);

    const label = document.createElementNS(SVG_NS, 'text');
    label.setAttribute('class', 'sd-nucleus-text');
    label.setAttribute('x', String(cx));
    label.setAttribute('y', String(cy));
    label.textContent = String(z);
    svg.appendChild(label);

    return svg;
  }

  function initTable(root: HTMLElement): void {
    const gridEl = root.querySelector<HTMLElement>('[data-ptbl-grid]');
    const panelEl = root.querySelector<HTMLElement>('[data-ptbl-panel]');
    if (!gridEl || !panelEl) return;

    // Re-bind as definitely-defined so the nested handlers below keep the type.
    const grid: HTMLElement = gridEl;
    const panel: HTMLElement = panelEl;

    const searchInput = root.querySelector<HTMLInputElement>('[data-ptbl-search]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-ptbl-clear]');
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ptbl-cat]'));
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-ptbl-reset]');
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ptbl-view]'));
    const tempBar = root.querySelector<HTMLElement>('[data-ptbl-tempbar]');
    const tempRange = root.querySelector<HTMLInputElement>('[data-ptbl-temprange]');
    const tempOut = root.querySelector<HTMLElement>('[data-ptbl-tempout]');
    const tally = root.querySelector<HTMLElement>('[data-ptbl-tally]');
    const presets = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ptbl-preset]'));
    const status = root.querySelector<HTMLElement>('[data-ptbl-status]');
    const scroller = root.querySelector<HTMLElement>('[data-ptbl-scroller]');
    const hint = root.querySelector<HTMLElement>('[data-ptbl-hint]');
    const scrim = root.querySelector<HTMLElement>('[data-ptbl-scrim]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-ptbl-close]');
    const tile = panel.querySelector<HTMLElement>('[data-ptbl-tile]');
    const shellArt = panel.querySelector<HTMLElement>('[data-ptbl-shellart]');
    const panelTitle = panel.querySelector<HTMLElement>('.ptbl-panel-title');

    const fields = new Map<string, HTMLElement>();
    panel.querySelectorAll<HTMLElement>('[data-f]').forEach((el) => {
      const key = el.dataset.f;
      if (key) fields.set(key, el);
    });
    const setField = (key: string, value: string): void => {
      const el = fields.get(key);
      if (el) el.textContent = value;
    };

    const axisCells = Array.from(root.querySelectorAll<HTMLElement>('.ptbl-axis'));
    const cells: Cell[] = Array.from(
      grid.querySelectorAll<HTMLButtonElement>('.ptbl-cell'),
    ).map((el) => ({
      el,
      z: Number(el.dataset.z),
      x: Number(el.dataset.x),
      y: Number(el.dataset.y),
      cat: el.dataset.cat ?? '',
      search: el.dataset.search ?? '',
      melt: toNum(el.dataset.melt),
      boil: toNum(el.dataset.boil),
    }));

    const byPos = new Map<string, number>();
    cells.forEach((c, i) => byPos.set(`${c.x}:${c.y}`, i));

    let activeIndex = 0;
    let selected: Cell | null = null;
    let query = '';
    let activeCat: string | null = null;
    let view: 'category' | 'temp' = 'category';
    let temperature = 298;

    /* ---------- roving tabindex ---------- */
    function setActive(index: number, moveFocus: boolean): void {
      if (index < 0 || index >= cells.length) return;
      cells[activeIndex].el.tabIndex = -1;
      activeIndex = index;
      const cell = cells[activeIndex];
      cell.el.tabIndex = 0;
      if (moveFocus) cell.el.focus();
    }

    /* ---------- group / period cross-hair ---------- */
    let axisOn: HTMLElement[] = [];

    function clearAxis(): void {
      axisOn.forEach((el) => el.classList.remove('is-axis'));
      axisOn = [];
    }

    function markAxis(cell: Cell): void {
      clearAxis();
      cells.forEach((c) => {
        if (c === cell) return;
        if (c.x === cell.x || c.y === cell.y) {
          c.el.classList.add('is-axis');
          axisOn.push(c.el);
        }
      });
      axisCells.forEach((a) => {
        const ax = Number(a.style.getPropertyValue('--x'));
        const ay = Number(a.style.getPropertyValue('--y'));
        if (ax === cell.x || ay === cell.y) {
          a.classList.add('is-axis');
          axisOn.push(a);
        }
      });
    }

    /* ---------- filtering ---------- */
    function matches(c: Cell): boolean {
      if (activeCat && c.cat !== activeCat) return false;
      if (!query) return true;
      if (/^\d+$/.test(query)) return String(c.z).startsWith(query);
      return c.search.includes(query);
    }

    function applyFilter(): void {
      let hits = 0;
      cells.forEach((c) => {
        const ok = matches(c);
        c.el.classList.toggle('is-dim', !ok);
        if (ok) hits += 1;
      });

      if (resetBtn) resetBtn.hidden = !activeCat && !query;
      if (clearBtn) clearBtn.hidden = query.length === 0;

      if (status) {
        if (!query && !activeCat) {
          status.textContent = 'Showing all 118 elements.';
        } else {
          const bits: string[] = [];
          if (query) bits.push(`matching “${query}”`);
          if (activeCat) {
            const chip = chips.find((b) => b.dataset.ptblCat === activeCat);
            const label = chip?.querySelector('.ptbl-chip-full')?.textContent?.trim();
            if (label) bits.push(`in ${label}`);
          }
          status.textContent = `${hits} element${hits === 1 ? '' : 's'} ${bits.join(' ')}.`;
        }
      }
    }

    /* ---------- temperature view ---------- */
    function applyTemperature(): void {
      const counts: Record<Phase, number> = { solid: 0, liquid: 0, gas: 0, unknown: 0 };
      cells.forEach((c) => {
        const p = phaseAt(c.melt, c.boil, temperature);
        c.el.dataset.ph = p;
        counts[p] += 1;
      });
      if (tempOut) {
        tempOut.textContent = `${temperature} K · ${Math.round(temperature - 273.15)} °C`;
      }
      if (tally) {
        tally.textContent = `${counts.solid} solid · ${counts.liquid} liquid · ${counts.gas} gas · ${counts.unknown} unknown`;
      }
    }

    function setView(next: 'category' | 'temp'): void {
      view = next;
      root.dataset.view = next;
      viewBtns.forEach((b) => {
        const on = b.dataset.ptblView === next;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (tempBar) tempBar.hidden = next !== 'temp';
      if (next === 'temp') applyTemperature();
      if (status) {
        status.textContent =
          next === 'temp'
            ? `Temperature view on. Cells are coloured by phase at ${temperature} kelvin.`
            : 'Category view on. Cells are coloured by element category.';
      }
    }

    /* ---------- detail panel ---------- */
    let lastTrigger: HTMLElement | null = null;

    function openPanel(cell: Cell): void {
      const d = cell.el.dataset;
      if (selected) {
        selected.el.classList.remove('is-selected');
        selected.el.setAttribute('aria-expanded', 'false');
      }
      selected = cell;
      cell.el.classList.add('is-selected');
      cell.el.setAttribute('aria-expanded', 'true');
      lastTrigger = cell.el;

      if (tile) tile.dataset.cat = d.cat ?? '';
      panel.dataset.cat = d.cat ?? '';

      setField('tileZ', d.z ?? '');
      setField('tileSym', d.sym ?? '');
      setField('tileMass', d.mass ?? '');
      setField('name', d.name ?? '');
      setField('catlabel', d.catlabel ?? '');
      setField('desc', d.desc ?? '');
      setField('z', d.z ?? '');
      setField('mass', d.mass ?? '');
      setField('group', d.group === 'f-block' ? 'f-block' : (d.group ?? ''));
      setField('period', d.period ?? '');
      setField('cfg', d.cfg ?? '');
      setField('en', d.en ? d.en : 'No value defined');
      setField('phase', d.phaselabel ?? '');
      setField('melt', d.melttext ?? '');
      setField('boil', d.boiltext ?? '');

      const shells = (d.shells ?? '')
        .split(',')
        .map((s) => Number(s))
        .filter((s) => Number.isFinite(s) && s > 0);

      if (shellArt) {
        shellArt.replaceChildren(
          shellDiagram(shells, Number(d.z), d.name ?? 'this element'),
        );
      }
      setField('shellcounts', shells.length ? shells.join(' · ') : '—');

      panel.dataset.open = 'true';
      panel.removeAttribute('inert');
      if (scrim) {
        scrim.hidden = false;
        // next frame so the opacity transition actually runs
        requestAnimationFrame(() => scrim.classList.add('is-on'));
      }
      if (panelTitle) panelTitle.focus();
    }

    function closePanel(returnFocus = true): void {
      if (panel.dataset.open !== 'true') return;
      panel.dataset.open = 'false';
      panel.setAttribute('inert', '');
      if (scrim) {
        scrim.classList.remove('is-on');
        window.setTimeout(() => {
          if (panel.dataset.open !== 'true') scrim.hidden = true;
        }, 240);
      }
      if (selected) {
        selected.el.classList.remove('is-selected');
        selected.el.setAttribute('aria-expanded', 'false');
      }
      selected = null;
      if (returnFocus && lastTrigger) lastTrigger.focus();
      lastTrigger = null;
    }

    panel.setAttribute('inert', '');

    /* ---------- events ---------- */
    cells.forEach((cell, i) => {
      cell.el.addEventListener('click', () => {
        setActive(i, false);
        openPanel(cell);
      });
      cell.el.addEventListener('mouseenter', () => markAxis(cell));
      cell.el.addEventListener('focus', () => {
        setActive(i, false);
        markAxis(cell);
      });
      cell.el.addEventListener('blur', clearAxis);
    });

    grid.addEventListener('mouseleave', clearAxis);

    grid.addEventListener('keydown', (event: KeyboardEvent) => {
      const key = event.key;

      if (key === 'Escape') {
        closePanel();
        return;
      }

      const deltas: Record<string, [number, number]> = {
        ArrowRight: [1, 0],
        ArrowLeft: [-1, 0],
        ArrowDown: [0, 1],
        ArrowUp: [0, -1],
      };

      if (key in deltas) {
        event.preventDefault();
        const [dx, dy] = deltas[key];
        const from = cells[activeIndex];
        let x = from.x;
        let y = from.y;
        for (let step = 0; step < 24; step += 1) {
          x += dx;
          y += dy;
          if (x < 1 || x > 19 || y < 1 || y > 11) return;
          const hit = byPos.get(`${x}:${y}`);
          if (hit !== undefined) {
            setActive(hit, true);
            return;
          }
        }
        return;
      }

      if (key === 'Home' || key === 'End') {
        event.preventDefault();
        const row = cells
          .map((c, i) => ({ c, i }))
          .filter(({ c }) => c.y === cells[activeIndex].y)
          .sort((a, b) => a.c.x - b.c.x);
        if (!row.length) return;
        const target = key === 'Home' ? row[0] : row[row.length - 1];
        setActive(target.i, true);
      }
    });

    searchInput?.addEventListener('input', () => {
      query = searchInput.value.trim().toLowerCase();
      applyFilter();
    });

    searchInput?.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape' && searchInput.value) {
        event.stopPropagation();
        searchInput.value = '';
        query = '';
        applyFilter();
      }
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      query = '';
      applyFilter();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const cat = chip.dataset.ptblCat ?? null;
        activeCat = activeCat === cat ? null : cat;
        chips.forEach((c) => {
          c.setAttribute(
            'aria-pressed',
            c.dataset.ptblCat === activeCat ? 'true' : 'false',
          );
        });
        applyFilter();
      });
    });

    resetBtn?.addEventListener('click', () => {
      activeCat = null;
      query = '';
      if (searchInput) searchInput.value = '';
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      applyFilter();
    });

    viewBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.ptblView === 'temp' ? 'temp' : 'category';
        if (next !== view) setView(next);
      });
    });

    tempRange?.addEventListener('input', () => {
      temperature = Number(tempRange.value);
      applyTemperature();
    });

    presets.forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = Number(btn.dataset.ptblPreset);
        if (!Number.isFinite(value)) return;
        temperature = value;
        if (tempRange) tempRange.value = String(value);
        applyTemperature();
      });
    });

    closeBtn?.addEventListener('click', () => closePanel());
    scrim?.addEventListener('click', () => closePanel());

    panel.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape') closePanel();
    });

    scroller?.addEventListener(
      'scroll',
      () => {
        if (hint && scroller.scrollLeft > 24) hint.classList.add('is-gone');
      },
      { passive: true },
    );

    if (hint && scroller && scroller.scrollWidth <= scroller.clientWidth) {
      hint.classList.add('is-gone');
    }

    applyFilter();
    applyTemperature();
  }

  document.querySelectorAll<HTMLElement>('[data-ptbl]').forEach(initTable);
</script>
