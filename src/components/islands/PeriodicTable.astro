    --ph-unknown-bg: var(--bg-sunken);
    --ph-unknown-fg: var(--text-faint);
    --ph-unknown-key: var(--border-strong);

    --cell: clamp(48px, 4.9vw, 66px);
    --axis: calc(var(--cell) * 0.62);
    --gap: 3px;

    position: relative;
    display: block;
  }

  :global(:root[data-theme='dark']) .ptbl {
    --cat-alkali-bg: hsl(4 44% 21%);
    --cat-alkali-fg: hsl(6 92% 86%);
    --cat-alkali-key: hsl(4 82% 66%);

    --cat-alkaline-bg: hsl(26 46% 20%);
    --cat-alkaline-fg: hsl(30 94% 84%);
    --cat-alkaline-key: hsl(28 86% 62%);

    --cat-transition-bg: hsl(232 44% 26%);
    --cat-transition-fg: hsl(230 100% 88%);
    --cat-transition-key: hsl(232 100% 74%);

    --cat-posttransition-bg: hsl(191 46% 19%);
    --cat-posttransition-fg: hsl(188 88% 82%);
    --cat-posttransition-key: hsl(190 76% 58%);

    --cat-metalloid-bg: hsl(98 38% 18%);
    --cat-metalloid-fg: hsl(94 74% 82%);
    --cat-metalloid-key: hsl(97 56% 56%);

    --cat-nonmetal-bg: hsl(154 42% 17%);
    --cat-nonmetal-fg: hsl(150 76% 82%);
    --cat-nonmetal-key: hsl(153 60% 52%);

    --cat-halogen-bg: hsl(41 48% 19%);
    --cat-halogen-fg: hsl(46 94% 80%);
    --cat-halogen-key: hsl(44 88% 60%);

    --cat-noble-bg: hsl(330 42% 22%);
    --cat-noble-fg: hsl(330 94% 88%);
    --cat-noble-key: hsl(330 84% 70%);

    --cat-lanthanide-bg: hsl(260 42% 26%);
    --cat-lanthanide-fg: hsl(262 96% 89%);
    --cat-lanthanide-key: hsl(260 88% 74%);

    --cat-actinide-bg: hsl(292 38% 24%);
    --cat-actinide-fg: hsl(295 90% 89%);
    --cat-actinide-key: hsl(293 74% 70%);

    --ph-solid-bg: hsl(216 26% 22%);
    --ph-solid-fg: hsl(212 48% 86%);
    --ph-solid-key: hsl(214 32% 62%);

    --ph-liquid-bg: hsl(202 56% 20%);
    --ph-liquid-fg: hsl(198 90% 82%);
