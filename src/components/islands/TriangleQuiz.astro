<script>
  // ==================================================================
  // Triangle explorer: draggable / keyboard-operable vertices with a
  // live angle readout and classification.
  // ==================================================================

  type Pt = { x: number; y: number };

  const VB_W = 400;
  const VB_H = 320;
  const MARGIN = 40;
  const MIN_ANGLE = 4;
  const MIN_SIDE = 46;

  function dist(p: Pt, q: Pt): number {
    return Math.hypot(p.x - q.x, p.y - q.y);
  }

  function angleAt(p: Pt, q: Pt, r: Pt): number {
    const v1x = q.x - p.x;
    const v1y = q.y - p.y;
    const v2x = r.x - p.x;
    const v2y = r.y - p.y;
    const m1 = Math.hypot(v1x, v1y);
    const m2 = Math.hypot(v2x, v2y);
    if (m1 === 0 || m2 === 0) return 0;
    let cos = (v1x * v2x + v1y * v2y) / (m1 * m2);
    cos = Math.min(1, Math.max(-1, cos));
    return (Math.acos(cos) * 180) / Math.PI;
  }

  function anglesOf(p: Pt[]): [number, number, number] {
    return [angleAt(p[0], p[1], p[2]), angleAt(p[1], p[2], p[0]), angleAt(p[2], p[0], p[1])];
  }

  function isValidTriangle(p: Pt[]): boolean {
    const sides = [dist(p[0], p[1]), dist(p[1], p[2]), dist(p[2], p[0])];
    if (sides.some((s) => s < MIN_SIDE)) return false;
    const angles = anglesOf(p);
    if (angles.some((a) => a < MIN_ANGLE)) return false;
    return true;
  }

  function clampCoord(v: number, lo: number, hi: number): number {
    return Math.min(hi, Math.max(lo, v));
  }

  function initExplorer(): void {
    const root = document.querySelector<HTMLElement>('[data-explorer]');
    if (!root) return;

    const svg = root.querySelector<SVGSVGElement>('[data-tri-svg]');
    const polygonEl = root.querySelector<SVGPolygonElement>('[data-poly]');
    const arcEls = Array.from(root.querySelectorAll<SVGPathElement>('[data-arc]'));
    const labelEls = Array.from(root.querySelectorAll<SVGTextElement>('[data-angle-label]'));
    const nameEls = Array.from(root.querySelectorAll<SVGTextElement>('[data-name-label]'));
    const hitEls = Array.from(root.querySelectorAll<SVGCircleElement>('[data-hit]'));
    const dotEls = Array.from(root.querySelectorAll<SVGCircleElement>('[data-dot]'));
    const chipEls = Array.from(root.querySelectorAll<HTMLElement>('[data-chip]'));
    const equationEl = root.querySelector<HTMLElement>('[data-equation]');
    const classificationEl = root.querySelector<HTMLElement>('[data-classification]');
    const liveEl = root.querySelector<HTMLElement>('[data-live]');

    if (!svg || !polygonEl || !equationEl || !classificationEl || !liveEl) return;
    if (
      arcEls.length !== 3 ||
      labelEls.length !== 3 ||
      nameEls.length !== 3 ||
      hitEls.length !== 3 ||
      dotEls.length !== 3 ||
      chipEls.length !== 3
    ) {
      return;
    }

    let pts: Pt[] = [
      { x: 200, y: 50 },
      { x: 70, y: 260 },
      { x: 330, y: 230 },
    ];

    let lastDisp: [number, number, number] = [0, 0, 0];
    let lastWords = '';

    function toSvgPoint(clientX: number, clientY: number): Pt {
      const ctm = svg!.getScreenCTM();
      if (!ctm) return { x: clientX, y: clientY };
      const p = new DOMPoint(clientX, clientY).matrixTransform(ctm.inverse());
      return { x: p.x, y: p.y };
    }

    function classify(
      angles: [number, number, number],
      sides: [number, number, number]
    ): { byAngle: string; bySide: string } {
      const max = Math.max(angles[0], angles[1], angles[2]);
      let byAngle: string;
      if (Math.abs(max - 90) <= 1.5) byAngle = 'right';
      else if (max > 90) byAngle = 'obtuse';
      else byAngle = 'acute';

      const avg = (sides[0] + sides[1] + sides[2]) / 3;
      const tol = avg * 0.02;
      const ab = Math.abs(sides[0] - sides[1]) <= tol;
      const bc = Math.abs(sides[1] - sides[2]) <= tol;
      const ca = Math.abs(sides[2] - sides[0]) <= tol;
      let bySide: string;
      if (ab && bc && ca) bySide = 'equilateral';
      else if (ab || bc || ca) bySide = 'isosceles';
      else bySide = 'scalene';
      return { byAngle, bySide };
    }

    function render(): void {
      const angles = anglesOf(pts);
      const sides: [number, number, number] = [dist(pts[0], pts[1]), dist(pts[1], pts[2]), dist(pts[2], pts[0])];
      const { byAngle, bySide } = classify(angles, sides);

      polygonEl!.setAttribute('points', pts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' '));

      const rawA = Math.round(angles[0]);
      const rawB = Math.round(angles[1]);
      const dispFixed: [number, number, number] = [rawA, rawB, 180 - rawA - rawB];

      for (let i = 0; i < 3; i++) {
        const p = pts[i];
        hitEls[i].setAttribute('cx', p.x.toFixed(1));
        hitEls[i].setAttribute('cy', p.y.toFixed(1));
        dotEls[i].setAttribute('cx', p.x.toFixed(1));
        dotEls[i].setAttribute('cy', p.y.toFixed(1));

        const q = pts[(i + 1) % 3];
        const r = pts[(i + 2) % 3];
        const a1 = Math.atan2(q.y - p.y, q.x - p.x);
        const a2 = Math.atan2(r.y - p.y, r.x - p.x);
        let delta = a2 - a1;
        while (delta <= -Math.PI) delta += Math.PI * 2;
        while (delta > Math.PI) delta -= Math.PI * 2;
        const sweep = delta > 0 ? 1 : 0;
        const rArc = Math.min(30, 0.4 * Math.min(dist(p, q), dist(p, r)));
        const sx = p.x + rArc * Math.cos(a1);
        const sy = p.y + rArc * Math.sin(a1);
        const ex = p.x + rArc * Math.cos(a2);
        const ey = p.y + rArc * Math.sin(a2);
        arcEls[i].setAttribute(
          'd',
          `M ${sx.toFixed(1)} ${sy.toFixed(1)} A ${rArc.toFixed(1)} ${rArc.toFixed(1)} 0 0 ${sweep} ${ex.toFixed(1)} ${ey.toFixed(1)}`
        );

        const bisector = a1 + delta / 2;
        const labelR = rArc + 16;
        labelEls[i].setAttribute('x', (p.x + labelR * Math.cos(bisector)).toFixed(1));
        labelEls[i].setAttribute('y', (p.y + labelR * Math.sin(bisector)).toFixed(1));
        labelEls[i].textContent = `${dispFixed[i]}°`;

        const outR = 26;
        nameEls[i].setAttribute('x', (p.x - outR * Math.cos(bisector)).toFixed(1));
        nameEls[i].setAttribute('y', (p.y - outR * Math.sin(bisector)).toFixed(1));
      }

      chipEls[0].textContent = `${dispFixed[0]}°`;
      chipEls[1].textContent = `${dispFixed[1]}°`;
      chipEls[2].textContent = `${dispFixed[2]}°`;
      equationEl!.textContent = `${dispFixed[0]}° + ${dispFixed[1]}° + ${dispFixed[2]}° = 180°`;

      const angleWord = byAngle.charAt(0).toUpperCase() + byAngle.slice(1);
      classificationEl!.textContent = `${angleWord}, ${bySide} triangle`;

      lastDisp = dispFixed;
      lastWords = `${byAngle}, ${bySide}`;
    }

    function announce(): void {
      liveEl!.textContent = `Angle A ${lastDisp[0]} degrees, angle B ${lastDisp[1]} degrees, angle C ${lastDisp[2]} degrees. They sum to 180 degrees. Triangle is ${lastWords}.`;
    }

    function tryMove(i: number, x: number, y: number): void {
      const nx = clampCoord(x, MARGIN, VB_W - MARGIN);
      const ny = clampCoord(y, MARGIN, VB_H - MARGIN);
      const candidate = pts.slice();
      candidate[i] = { x: nx, y: ny };
      if (!isValidTriangle(candidate)) return;
      pts = candidate;
      render();
    }

    hitEls.forEach((hit, i) => {
      hit.addEventListener('pointerdown', (e: PointerEvent) => {
        e.preventDefault();
        hit.setPointerCapture(e.pointerId);
        hit.classList.add('is-dragging');
      });

      hit.addEventListener('pointermove', (e: PointerEvent) => {
        if (!hit.hasPointerCapture(e.pointerId)) return;
        const p = toSvgPoint(e.clientX, e.clientY);
        tryMove(i, p.x, p.y);
      });

      const endDrag = (e: PointerEvent) => {
        if (hit.hasPointerCapture(e.pointerId)) hit.releasePointerCapture(e.pointerId);
        hit.classList.remove('is-dragging');
        announce();
      };
      hit.addEventListener('pointerup', endDrag);
      hit.addEventListener('pointercancel', endDrag);

      hit.addEventListener('keydown', (e: KeyboardEvent) => {
        const step = e.shiftKey ? 2 : 8;
        let dx = 0;
        let dy = 0;
        if (e.key === 'ArrowUp') dy = -step;
        else if (e.key === 'ArrowDown') dy = step;
        else if (e.key === 'ArrowLeft') dx = -step;
        else if (e.key === 'ArrowRight') dx = step;
        else return;
        e.preventDefault();
        tryMove(i, pts[i].x + dx, pts[i].y + dy);
        announce();
      });
    });

    render();
  }

  // ==================================================================
  // Quiz: progress, scoring, per-question feedback, reshuffling and a
  // best-score record kept in localStorage.
  // ==================================================================

  const STORAGE_KEY = 'tfc-triangle-quiz';

  const CONCEPT_LABELS: Record<string, string> = {
    sum: 'Interior angle sum — the three angles of a triangle always total 180°.',
    exterior: 'Exterior angle theorem — an exterior angle equals the sum of the two remote interior angles.',
    isosceles: 'Isosceles triangles — the base angles opposite the equal sides are equal.',
    equilateral: 'Equilateral triangles — all three angles measure 60°.',
    classify: 'Classifying triangles — by angle (acute/right/obtuse) and by side (scalene/isosceles/equilateral).',
    sideangle: 'Side–angle relationships — the longest side is always opposite the largest angle.',
    parallel: 'Parallel lines & transversals — alternate interior angles are equal.',
  };

  const CHECK_ICON =
    '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M6 10.4l2.6 2.6L14.3 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const X_ICON =
    '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M7 7l6 6M13 7l-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';

  function loadBestScore(total: number): number {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return 0;
      const parsed = JSON.parse(raw) as { best?: number; total?: number };
      if (typeof parsed.best === 'number' && parsed.total === total) return parsed.best;
      return 0;
    } catch {
      return 0;
    }
  }

  function saveBestScore(best: number, total: number): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ best, total }));
    } catch {
      /* localStorage unavailable (private browsing, blocked storage, etc.) */
    }
  }

  function shuffleChildren(container: Element): void {
    const items = Array.from(container.children);
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const tmp = items[i];
      items[i] = items[j];
      items[j] = tmp;
    }
    items.forEach((el) => container.appendChild(el));
  }

  function initQuiz(): void {
    const root = document.querySelector<HTMLElement>('[data-quiz]');
    if (!root) return;

    const questionEls = Array.from(root.querySelectorAll<HTMLFieldSetElement>('[data-question]'));
    const progressBar = root.querySelector<HTMLProgressElement>('[data-progress-bar]');
    const progressText = root.querySelector<HTMLElement>('[data-progress-text]');
    const resultsPanel = root.querySelector<HTMLElement>('[data-results]');
    const quizBody = root.querySelector<HTMLElement>('[data-quiz-body]');
    const resultsScoreEl = root.querySelector<HTMLElement>('[data-results-score]');
    const resultsBestEl = root.querySelector<HTMLElement>('[data-results-best]');
    const resultsReviewEl = root.querySelector<HTMLElement>('[data-results-review]');
    const retryBtn = root.querySelector<HTMLButtonElement>('[data-retry]');

    if (
      !progressBar ||
      !progressText ||
      !resultsPanel ||
      !quizBody ||
      !resultsScoreEl ||
      !resultsBestEl ||
      !resultsReviewEl ||
      !retryBtn ||
      questionEls.length === 0
    ) {
      return;
    }

    const total = questionEls.length;
    let current = 0;
    let score = 0;
    const answered: boolean[] = new Array(total).fill(false);
    const answeredCorrect: boolean[] = new Array(total).fill(false);

    function optionGroups(): HTMLElement[] {
      return Array.from(root!.querySelectorAll<HTMLElement>('.options'));
    }

    function updateCheckEnabled(fieldset: HTMLFieldSetElement): void {
      const checkBtn = fieldset.querySelector<HTMLButtonElement>('[data-check]');
      if (!checkBtn) return;
      if (fieldset.dataset.type === 'mc') {
        const checked = fieldset.querySelector<HTMLInputElement>('input[type="radio"]:checked');
        checkBtn.disabled = !checked;
      } else {
        const input = fieldset.querySelector<HTMLInputElement>('[data-numeric-input]');
        checkBtn.disabled = !input || input.value.trim() === '';
      }
    }

    function resetQuestionUI(fieldset: HTMLFieldSetElement): void {
      const radios = Array.from(fieldset.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
      radios.forEach((r) => {
        r.checked = false;
        r.disabled = false;
      });
      fieldset.querySelectorAll('.option').forEach((el) => el.classList.remove('is-selected'));

      const numInput = fieldset.querySelector<HTMLInputElement>('[data-numeric-input]');
      if (numInput) {
        numInput.value = '';
        numInput.disabled = false;
      }

      const feedback = fieldset.querySelector<HTMLElement>('[data-feedback]');
      if (feedback) {
        feedback.textContent = '';
        feedback.className = 'feedback';
      }

      const checkBtn = fieldset.querySelector<HTMLButtonElement>('[data-check]');
      const nextBtn = fieldset.querySelector<HTMLButtonElement>('[data-next]');
      if (checkBtn) {
        checkBtn.hidden = false;
        checkBtn.disabled = true;
      }
      if (nextBtn) nextBtn.hidden = true;
    }

    function showQuestion(index: number): void {
      questionEls.forEach((fs, i) => {
        fs.hidden = i !== index;
      });
      progressBar!.value = index + 1;
      progressText!.textContent = `Question ${index + 1} of ${total}`;
    }

    function checkAnswer(fieldset: HTMLFieldSetElement, index: number): void {
      const type = fieldset.dataset.type;
      const feedback = fieldset.querySelector<HTMLElement>('[data-feedback]');
      const explanation = fieldset.dataset.explanation ?? '';
      let correct = false;
      let correctText = '';

      if (type === 'mc') {
        const checked = fieldset.querySelector<HTMLInputElement>('input[type="radio"]:checked');
        if (!checked) return;
        correct = checked.dataset.correct === 'true';
        const correctInput = fieldset.querySelector<HTMLInputElement>('input[data-correct="true"]');
        const label = correctInput ? correctInput.closest('label') : null;
        const textEl = label ? label.querySelector<HTMLElement>('.option-text') : null;
        correctText = textEl?.textContent ?? '';
      } else {
        const input = fieldset.querySelector<HTMLInputElement>('[data-numeric-input]');
        if (!input) return;
        const value = parseFloat(input.value);
        const answer = parseFloat(fieldset.dataset.answer ?? '0');
        const tolerance = parseFloat(fieldset.dataset.tolerance ?? '0.5');
        correct = !Number.isNaN(value) && Math.abs(value - answer) <= tolerance;
        correctText = `${fieldset.dataset.answer}°`;
      }

      if (!answered[index]) {
        answered[index] = true;
        answeredCorrect[index] = correct;
        if (correct) score += 1;
      }

      fieldset.querySelectorAll<HTMLInputElement>('input').forEach((el) => {
        el.disabled = true;
      });

      if (feedback) {
        feedback.className = `feedback ${correct ? 'is-correct' : 'is-incorrect'}`;
        const icon = correct ? CHECK_ICON : X_ICON;
        const lead = correct ? 'Correct.' : `Not quite — the correct answer is ${correctText}.`;
        feedback.innerHTML = `${icon}<span>${lead} ${explanation}</span>`;
      }

      const checkBtn = fieldset.querySelector<HTMLButtonElement>('[data-check]');
      const nextBtn = fieldset.querySelector<HTMLButtonElement>('[data-next]');
      if (checkBtn) checkBtn.hidden = true;
      if (nextBtn) {
        nextBtn.hidden = false;
        nextBtn.focus();
      }
    }

    function showResults(): void {
      quizBody!.hidden = true;
      resultsPanel!.hidden = false;

      const best = loadBestScore(total);
      const isNewBest = score > best;
      if (isNewBest) saveBestScore(score, total);
      const bestToShow = isNewBest ? score : best;

      resultsScoreEl!.textContent = `You scored ${score} out of ${total}.`;
      resultsBestEl!.textContent = isNewBest
        ? 'New best score!'
        : `Best score so far: ${bestToShow} out of ${total}.`;

      const missedConcepts = new Set<string>();
      questionEls.forEach((fs, i) => {
        if (!answeredCorrect[i] && fs.dataset.concept) missedConcepts.add(fs.dataset.concept);
      });

      resultsReviewEl!.innerHTML = '';
      if (missedConcepts.size === 0) {
        const li = document.createElement('li');
        li.textContent = 'Great work — you got every concept right!';
        resultsReviewEl!.appendChild(li);
      } else {
        missedConcepts.forEach((c) => {
          const li = document.createElement('li');
          li.textContent = CONCEPT_LABELS[c] ?? c;
          resultsReviewEl!.appendChild(li);
        });
      }

      resultsPanel!.querySelector('h3')?.setAttribute('tabindex', '-1');
      (resultsPanel!.querySelector('h3') as HTMLElement | null)?.focus();
    }

    function resetQuiz(): void {
      current = 0;
      score = 0;
      for (let i = 0; i < total; i++) {
        answered[i] = false;
        answeredCorrect[i] = false;
      }
      questionEls.forEach((fs) => resetQuestionUI(fs));
      optionGroups().forEach((g) => shuffleChildren(g));
      resultsPanel!.hidden = true;
      quizBody!.hidden = false;
      showQuestion(0);
    }

    questionEls.forEach((fieldset, index) => {
      const checkBtn = fieldset.querySelector<HTMLButtonElement>('[data-check]');
      const nextBtn = fieldset.querySelector<HTMLButtonElement>('[data-next]');
      const numInput = fieldset.querySelector<HTMLInputElement>('[data-numeric-input]');

      fieldset.addEventListener('change', (e: Event) => {
        const target = e.target as HTMLElement | null;
        if (target && target instanceof HTMLInputElement && target.type === 'radio') {
          fieldset.querySelectorAll('.option').forEach((el) => el.classList.remove('is-selected'));
          target.closest('.option')?.classList.add('is-selected');
        }
        updateCheckEnabled(fieldset);
      });

      if (numInput) {
        numInput.addEventListener('input', () => updateCheckEnabled(fieldset));
      }

      checkBtn?.addEventListener('click', () => checkAnswer(fieldset, index));

      nextBtn?.addEventListener('click', () => {
        if (index === total - 1) {
          showResults();
          return;
        }
        current = index + 1;
        showQuestion(current);
        const nextFieldset = questionEls[current];
        const legend = nextFieldset.querySelector<HTMLElement>('legend');
        if (legend) {
          legend.setAttribute('tabindex', '-1');
          legend.focus();
        }
      });
    });

    retryBtn.addEventListener('click', () => resetQuiz());

    optionGroups().forEach((g) => shuffleChildren(g));
    questionEls.forEach((fs) => resetQuestionUI(fs));
    showQuestion(0);
  }

  initExplorer();
  initQuiz();
</script>
