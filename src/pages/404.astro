---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { courses } from '../data/site';

const suggestions = courses.filter((c) => c.lessons.length > 0);
---

<Base title="Page not found" description="That page doesn't exist.">
  <section class="nf">
    <div class="container container-narrow">
      <div class="cells" aria-hidden="true">
        <span></span><span></span><span></span><span class="gone"></span>
      </div>

      <h1>One cell short</h1>
      <p class="lede">
        That page doesn't exist — it may have moved during the site rebuild, or the
        link may be wrong.
      </p>

      <div class="actions">
        <a href="/" class="btn">
          Back home
          <Icon name="arrow" size={17} class="btn-arrow" />
        </a>
        <a href="/courses" class="btn btn-secondary">Browse courses</a>
      </div>

      {
        suggestions.length > 0 && (
          <div class="sugg">
            <p class="sugg-head">Or try one of these</p>
            <ul role="list">
              {suggestions.flatMap((c) =>
                c.lessons.map((l) => (
                  <li>
                    <a href={`/courses/${c.slug}/${l.slug}`}>
                      <Icon name={c.icon} size={17} />
                      <span>
                        <span class="sugg-title">{l.title}</span>
                        <span class="sugg-course">{c.title}</span>
                      </span>
                      <Icon name="arrow" size={15} class="btn-arrow" />
                    </a>
                  </li>
                ))
              )}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(3rem, 9vw, 7rem);
    text-align: center;
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    width: 92px;
    margin: 0 auto var(--sp-6);
  }

  .cells span {
    aspect-ratio: 1;
    border-radius: 10px;
    background: var(--accent);
  }

  .cells .gone {
    background: transparent;
    border: 2px dashed var(--border-strong);
    animation: pulse 2.6s var(--ease-in-out) infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }

  h1 { font-size: var(--fs-3xl); font-weight: 500; margin-bottom: var(--sp-4); }

  .lede {
    max-width: 48ch;
    margin-inline: auto;
    font-size: var(--fs-lg);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
    margin-top: var(--sp-6);
  }

  .sugg {
    margin-top: var(--sp-8);
    text-align: left;
  }

  .sugg-head {
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-faint);
    text-align: center;
    margin-bottom: var(--sp-4);
  }

  .sugg ul { display: grid; gap: var(--sp-2); }

  .sugg a {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }

  .sugg a:hover { border-color: var(--accent); }

  .sugg-title { display: block; font-size: var(--fs-sm); font-weight: 500; }

  .sugg-course { display: block; font-size: var(--fs-xs); color: var(--text-faint); }

  .sugg :global(.btn-arrow) {
    margin-left: auto;
    color: var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  .sugg a:hover :global(.btn-arrow) { transform: translateX(3px); }
</style>
