---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { courses } from '../data/site';

const steps = [
  { n: 1, title: 'Send us a draft', body: 'Any stage is fine — an outline, a rough draft, or a finished piece.' },
  { n: 2, title: 'We review it together', body: 'An editor reads it and sends notes. Expect a round or two of revisions.' },
  { n: 3, title: 'It gets published', body: 'Your work goes live under your name, free for anyone to read.' },
];
---

<Base
  title="Submit an Article"
  description="Publish your STEM writing with thefourcells — free, student-reviewed, and open to anyone."
>
  <section class="page-head">
    <div class="container container-narrow">
      <p class="eyebrow"><Icon name="mail" size={14} /> Submit</p>
      <h1>Publish your work</h1>
      <p class="lede">
        We publish student writing across every STEM field — explainers, research,
        lab write-ups, and interactive lessons. You don't need to be an expert. You
        need to have understood something and be able to explain it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol role="list" class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--reveal-delay:${Math.min(i * 70, 150)}ms`}>
              <span class="step-n">{s.n}</span>
              <h2>{s.title}</h2>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <form class="form" data-submit-form novalidate>
        <h2 class="form-title">Tell us about your piece</h2>

        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
          <p class="err" data-err-for="name" hidden></p>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
          <p class="err" data-err-for="email" hidden></p>
        </div>

        <div class="field">
          <label for="subject">Subject area</label>
          <select id="subject" name="subject">
            <option value="">Choose one…</option>
            {courses.map((c) => <option value={c.slug}>{c.title}</option>)}
            <option value="other">Other</option>
          </select>
        </div>

        <div class="field">
          <label for="title">Working title</label>
          <input id="title" name="title" type="text" required />
          <p class="err" data-err-for="title" hidden></p>
        </div>

        <div class="field">
          <label for="pitch">
            What's it about?
            <span class="hint">A paragraph is plenty.</span>
          </label>
          <textarea id="pitch" name="pitch" rows="5" required></textarea>
          <p class="err" data-err-for="pitch" hidden></p>
        </div>

        <div class="field">
          <label for="link">
            Link to a draft
            <span class="hint">Optional — Google Docs, PDF, anything readable.</span>
          </label>
          <input id="link" name="link" type="url" placeholder="https://" />
          <p class="err" data-err-for="link" hidden></p>
        </div>

        <button type="submit" class="btn form-submit">
          Send submission
          <Icon name="arrow" size={17} class="btn-arrow" />
        </button>

        <p class="form-note" role="status" data-form-status></p>

        <p class="wiring">
          <Icon name="spark" size={15} />
          <span>
            This form needs a submission endpoint wired up before it can deliver mail —
            it currently validates input but does not send.
          </span>
        </p>
      </form>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(2.5rem, 6vw, 5rem) 0; }

  .page-head h1 {
    font-size: var(--fs-3xl);
    font-weight: 500;
    margin-block: var(--sp-3) var(--sp-4);
  }

  .lede { font-size: var(--fs-lg); color: var(--text-muted); line-height: 1.75; }

  .steps {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    counter-reset: step;
  }

  .step {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    padding: var(--sp-6);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .step-n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-full);
    background: var(--accent);
    color: var(--text-on-accent);
    font-weight: 700;
  }

  .step h2 { font-size: var(--fs-lg); font-weight: 500; }
  .step p { font-size: var(--fs-sm); line-height: 1.7; color: var(--text-muted); }

  .form {
    display: grid;
    gap: var(--sp-5);
    padding: var(--sp-7);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-md);
  }

  .form-title { font-size: var(--fs-xl); font-weight: 500; }

  .field { display: grid; gap: var(--sp-2); }

  label { font-size: var(--fs-sm); font-weight: 500; }

  .hint {
    display: block;
    font-weight: 300;
    color: var(--text-faint);
    font-size: var(--fs-xs);
    margin-top: 2px;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75em 0.9em;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--text);
    font-size: var(--fs-base);
    transition: border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  textarea { resize: vertical; line-height: 1.6; }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: #d92d20;
  }

  .err {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    font-size: var(--fs-xs);
    color: #d92d20;
  }

  :global(:root[data-theme='dark']) .err { color: #ff8a80; }

  .form-submit { justify-self: start; }

  .form-note:empty { display: none; }

  .form-note {
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-sm);
    background: var(--accent-subtle);
    color: var(--accent);
    font-size: var(--fs-sm);
  }

  .wiring {
    display: flex;
    gap: var(--sp-2);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--text-faint);
  }

  .wiring :global(svg) { flex-shrink: 0; margin-top: 2px; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-submit-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  const showError = (field: HTMLElement, message: string) => {
    const box = document.querySelector<HTMLElement>(`[data-err-for="${field.id}"]`);
    field.setAttribute('aria-invalid', 'true');
    if (box) {
      box.textContent = message;
      box.hidden = false;
    }
  };

  const clearError = (field: HTMLElement) => {
    const box = document.querySelector<HTMLElement>(`[data-err-for="${field.id}"]`);
    field.removeAttribute('aria-invalid');
    if (box) box.hidden = true;
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form || !status) return;

    const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      'input, textarea'
    );

    // A for...of loop keeps control-flow narrowing intact; inside a forEach
    // callback TypeScript cannot see the assignment and narrows firstBad to never.
    let firstBad: HTMLElement | null = null;
    for (const f of fields) {
      clearError(f);
      if (f.hasAttribute('required') && !f.value.trim()) {
        showError(f, 'This field is required.');
        firstBad ??= f;
      } else if (f.type === 'email' && f.value && !f.checkValidity()) {
        showError(f, 'Enter a valid email address.');
        firstBad ??= f;
      } else if (f.type === 'url' && f.value && !f.checkValidity()) {
        showError(f, 'Enter a valid URL, starting with https://');
        firstBad ??= f;
      }
    }

    if (firstBad) {
      firstBad.focus();
      status.textContent = '';
      return;
    }

    status.textContent =
      'Looks good — but no endpoint is connected yet, so this was not sent.';
  });

  form?.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t.getAttribute('aria-invalid') === 'true') clearError(t);
  });
</script>
