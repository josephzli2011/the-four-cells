  }

  .mx-gas-col ul {
    display: grid;
    gap: 0.3em;
    font-size: var(--fs-sm);
  }

  .mx-panel-note {
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  /* ---- Weight tool ----------------------------------------------------*/
  .mx-weight {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: end;
  }

  .mx-weight-field {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
  }

  .mx-weight-field label {
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  #mx-weight-input {
    width: 10em;
    padding: 0.6em 0.8em;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--text);
  }

  #mx-weight-input:focus-visible {
    border-color: var(--accent);
  }

  .mx-unit-toggle {
    display: inline-flex;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-full);
    overflow: hidden;
  }

  .mx-unit-toggle button {
    padding: 0.6em 1.1em;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-muted);
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .mx-unit-toggle button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .mx-weight-result {
    margin-top: var(--sp-4);
