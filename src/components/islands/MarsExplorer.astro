  }

  .mx-bar-track {
    height: 0.7em;
    border-radius: var(--r-full);
    background: var(--bg-sunken);
    overflow: hidden;
  }

  .mx-bar-fill {
    display: block;
    height: 100%;
    border-radius: var(--r-full);
    transition: width var(--dur-slow) var(--ease);
  }

  .mx-bar-fill--earth {
    background: var(--mx-earth-ocean);
  }

  .mx-bar-fill--mars {
    background: var(--mx-rust-500);
  }

  .mx-bar-value {
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .mx-gauge-track {
    position: relative;
    height: 10px;
    border-radius: var(--r-full);
    background: linear-gradient(
      90deg,
      var(--mx-earth-ocean-deep),
      var(--bg-sunken) 50%,
      var(--mx-rust-500)
    );
    margin-block: var(--sp-4) var(--sp-3);
  }

  .mx-gauge-mark {
    position: absolute;
    top: 50%;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
    background: var(--surface);
    border: 2px solid var(--text);
  }

  .mx-gauge-mark--earth {
    border-radius: var(--r-full);
    border-color: var(--mx-earth-ocean);
  }

  .mx-gauge-mark--mars {
    border-radius: var(--r-xs);
    border-color: var(--mx-rust-700);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .mx-gauge-labels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    font-size: var(--fs-sm);
  }

  .mx-dot {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    border-radius: var(--r-full);
    margin-right: 0.35em;
