---
// TriangleQuiz.astro
// Self-contained, framework-free interactive lesson + quiz on the angles of a
// triangle. No network calls, no build-time or runtime dependencies beyond
// what Astro/the browser already provide. All diagrams are inline SVG, drawn
// to scale from the actual angle values at build time.

interface QuestionBase {
  id: string;
  concept: 'sum' | 'exterior' | 'isosceles' | 'equilateral' | 'classify' | 'sideangle' | 'parallel';
  prompt: string;
  diagramViewBox: string;
  diagramSvg: string;
  diagramAlt: string;
  explanation: string;
}

interface MCQuestion extends QuestionBase {
  type: 'mc';
  options: string[];
  correctIndex: number;
}

interface NumericQuestion extends QuestionBase {
  type: 'numeric';
  answer: number;
  tolerance: number;
}

type Question = MCQuestion | NumericQuestion;

const questions: Question[] = [
  {
    id: 'q1',
    type: 'numeric',
    concept: 'sum',
    prompt: 'In triangle ABC, angle A = 58° and angle B = 79°. What is the measure of angle C?',
    diagramViewBox: '-8 -8 173 180',
    diagramAlt: 'Triangle A B C with angle A and angle B labeled, and angle C marked as unknown.',
    diagramSvg: `
      <polygon class="q-shape" points="26.0,146.2 131.0,146.2 106.1,18.0" />
      <path class="q-arc" d="M 46.0 146.2 A 20.0 20.0 0 0 0 36.6 129.2" />
      <path class="q-arc" d="M 127.2 126.5 A 20.0 20.0 0 0 0 111.0 146.2" />
      <path class="q-arc" d="M 97.6 31.6 A 16.0 16.0 0 0 0 109.1 33.7" />
      <text class="q-angle-label" x="56.6" y="129.2">58°</text>
      <text class="q-angle-label" x="104.0" y="123.9">79°</text>
      <text class="q-angle-label" x="100.4" y="48.5">?</text>
      <circle class="q-pt" cx="26.0" cy="146.2" r="2.6" />
      <circle class="q-pt" cx="131.0" cy="146.2" r="2.6" />
      <circle class="q-pt" cx="106.1" cy="18.0" r="2.6" />
      <text class="q-vertex-label" x="20.0" y="162.2">A</text>
      <text class="q-vertex-label" x="137.0" y="162.2">B</text>
      <text class="q-vertex-label" x="106.1" y="9.0">C</text>
    `,
    answer: 43,
    tolerance: 0.5,
    explanation:
      'The three interior angles of any triangle always add up to 180°, so the missing angle is 180° − 58° − 79° = 43°.',
  },
  {
    id: 'q2',
    type: 'numeric',
    concept: 'sum',
    prompt:
      "A triangle's three angles measure x°, 2x°, and 3x°. What is the value of the largest angle, in degrees?",
    diagramViewBox: '-8 -8 218 115',
    diagramAlt: 'Triangle with vertex angles labeled x degrees, 2x degrees, and 3x degrees.',
    diagramSvg: `
      <polygon class="q-shape" points="26.0,81.0 176.0,81.0 138.5,16.0" />
      <path class="q-arc" d="M 48.0 81.0 A 22.0 22.0 0 0 0 45.1 70.0" />
      <path class="q-arc" d="M 165.0 61.9 A 22.0 22.0 0 0 0 154.0 81.0" />
      <path class="q-arc" d="M 122.9 25.0 A 18.0 18.0 0 0 0 147.5 31.6" />
      <text class="q-angle-label" x="61.7" y="71.4">x°</text>
      <text class="q-angle-label" x="144.0" y="62.5">2x°</text>
      <text class="q-angle-label" x="130.0" y="47.9">3x°</text>
      <circle class="q-pt" cx="26.0" cy="81.0" r="2.6" />
      <circle class="q-pt" cx="176.0" cy="81.0" r="2.6" />
      <circle class="q-pt" cx="138.5" cy="16.0" r="2.6" />
      <text class="q-vertex-label" x="20.0" y="97.0">A</text>
      <text class="q-vertex-label" x="182.0" y="97.0">B</text>
      <text class="q-vertex-label" x="138.5" y="7.0">C</text>
    `,
    answer: 90,
    tolerance: 0.5,
    explanation:
      'Since x + 2x + 3x = 180°, x = 30°, which makes the largest angle 3x = 90° — this triangle turns out to be a right triangle.',
  },
  {
    id: 'q3',
    type: 'mc',
    concept: 'exterior',
    prompt:
      'In the triangle below, side BC is extended to point D. Angle A = 65° and angle B = 48°. What is the measure of the exterior angle, ∠ACD?',
    diagramViewBox: '-8 -8 230 141',
    diagramAlt:
      'Triangle A B C with side B C extended to point D, showing angle A, angle B, and the unknown exterior angle at C.',
    diagramSvg: `
      <polygon class="q-shape" points="105.6,16.0 24.0,106.6 144.0,106.6" />
      <line class="q-ext" x1="144.0" y1="106.6" x2="190.0" y2="106.6" />
      <path class="q-arc" d="M 92.2 30.9 A 20.0 20.0 0 0 0 113.4 34.4" />
      <path class="q-arc" d="M 37.4 91.7 A 20.0 20.0 0 0 1 44.0 106.6" />
      <path class="q-arc" d="M 166.0 106.6 A 22.0 22.0 0 0 0 135.4 86.3" />
      <text class="q-angle-label" x="99.8" y="50.5">65°</text>
      <text class="q-angle-label" x="56.0" y="92.3">48°</text>
      <text class="q-angle-label" x="164.4" y="75.7">?</text>
      <circle class="q-pt" cx="105.6" cy="16.0" r="2.6" />
      <circle class="q-pt" cx="24.0" cy="106.6" r="2.6" />
      <circle class="q-pt" cx="144.0" cy="106.6" r="2.6" />
      <circle class="q-pt" cx="190.0" cy="106.6" r="2.2" />
      <text class="q-vertex-label" x="105.6" y="7.0">A</text>
      <text class="q-vertex-label" x="18.0" y="122.6">B</text>
      <text class="q-vertex-label" x="144.0" y="122.6">C</text>
      <text class="q-vertex-label" x="197.0" y="109.6">D</text>
    `,
    options: ['113°', '67°', '48°', '132°'],
    correctIndex: 0,
    explanation:
      'An exterior angle of a triangle equals the sum of the two non-adjacent (remote) interior angles: 65° + 48° = 113°.',
  },
  {
    id: 'q4',
    type: 'numeric',
    concept: 'isosceles',
    prompt:
      'Triangle ABC is isosceles with AB = AC (marked with tick marks). Angle A = 38°. What is the measure of angle B?',
    diagramViewBox: '-8 -8 181 204',
    diagramAlt:
      'Isosceles triangle A B C with equal sides A B and A C marked by tick marks; angle A is labeled and angle B is unknown.',
    diagramSvg: `
      <polygon class="q-shape" points="82.5,18.0 30.0,170.5 135.0,170.5" />
      <path class="q-arc" d="M 76.6 35.0 A 18.0 18.0 0 0 0 88.4 35.0" />
      <path class="q-arc" d="M 50.0 170.5 A 20.0 20.0 0 0 0 36.5 151.6" />
      <line class="q-tick" x1="59.6" y1="95.4" x2="52.9" y2="93.1" />
      <line class="q-tick" x1="112.1" y1="93.1" x2="105.4" y2="95.4" />
      <text class="q-angle-label" x="82.5" y="51.0">38°</text>
      <text class="q-angle-label" x="58.5" y="150.1">?</text>
      <circle class="q-pt" cx="82.5" cy="18.0" r="2.6" />
      <circle class="q-pt" cx="30.0" cy="170.5" r="2.6" />
      <circle class="q-pt" cx="135.0" cy="170.5" r="2.6" />
      <text class="q-vertex-label" x="82.5" y="9.0">A</text>
      <text class="q-vertex-label" x="24.0" y="186.5">B</text>
      <text class="q-vertex-label" x="141.0" y="186.5">C</text>
    `,
    answer: 71,
    tolerance: 0.5,
    explanation:
      'Because AB = AC, the base angles opposite those sides are equal, so each base angle is (180° − 38°) ÷ 2 = 71°.',
  },
  {
    id: 'q5',
    type: 'mc',
    concept: 'equilateral',
    prompt:
      'Triangle ABC is equilateral — all three sides are equal in length, as marked. What is the measure of each interior angle?',
    diagramViewBox: '-8 -8 186 147',
    diagramAlt: 'Equilateral triangle A B C with all three sides marked equal by tick marks.',
    diagramSvg: `
      <polygon class="q-shape" points="30.0,113.3 140.0,113.3 85.0,18.0" />
      <line class="q-tick" x1="85.0" y1="109.8" x2="85.0" y2="116.8" />
      <line class="q-tick" x1="109.5" y1="67.4" x2="115.5" y2="63.9" />
      <line class="q-tick" x1="60.5" y1="67.4" x2="54.5" y2="63.9" />
      <circle class="q-pt" cx="30.0" cy="113.3" r="2.6" />
      <circle class="q-pt" cx="140.0" cy="113.3" r="2.6" />
      <circle class="q-pt" cx="85.0" cy="18.0" r="2.6" />
      <text class="q-vertex-label" x="24.0" y="129.3">A</text>
      <text class="q-vertex-label" x="146.0" y="129.3">B</text>
      <text class="q-vertex-label" x="85.0" y="9.0">C</text>
    `,
    options: ['45°', '60°', '90°', '120°'],
    correctIndex: 1,
    explanation: 'An equilateral triangle has three equal angles that add to 180°, and 180° ÷ 3 = 60°.',
  },
  {
    id: 'q6',
    type: 'mc',
    concept: 'classify',
    prompt: 'A triangle has angles measuring 96°, 42°, and 42°. How would you best classify this triangle?',
    diagramViewBox: '-8 -8 218 128',
    diagramAlt:
      'Triangle A B C with angle A ninety six degrees, angle B and angle C each forty two degrees, and the two equal sides marked with tick marks.',
    diagramSvg: `
      <polygon class="q-shape" points="101.0,26.0 26.0,93.5 176.0,93.5" />
      <path class="q-arc" d="M 86.1 39.4 A 20.0 20.0 0 0 0 115.9 39.4" />
      <path class="q-arc" d="M 46.0 93.5 A 20.0 20.0 0 0 0 40.9 80.1" />
      <path class="q-arc" d="M 161.1 80.1 A 20.0 20.0 0 0 0 156.0 93.5" />
      <line class="q-tick" x1="65.8" y1="62.4" x2="61.2" y2="57.2" />
      <line class="q-tick" x1="140.8" y1="57.2" x2="136.2" y2="62.4" />
      <text class="q-angle-label" x="101.0" y="61.0">96°</text>
      <text class="q-angle-label" x="58.7" y="81.0">42°</text>
      <text class="q-angle-label" x="143.3" y="81.0">42°</text>
      <circle class="q-pt" cx="101.0" cy="26.0" r="2.6" />
      <circle class="q-pt" cx="26.0" cy="93.5" r="2.6" />
      <circle class="q-pt" cx="176.0" cy="93.5" r="2.6" />
      <text class="q-vertex-label" x="101.0" y="17.0">A</text>
      <text class="q-vertex-label" x="20.0" y="109.5">B</text>
      <text class="q-vertex-label" x="182.0" y="109.5">C</text>
    `,
    options: ['Acute and scalene', 'Obtuse and isosceles', 'Right and scalene', 'Obtuse and equilateral'],
    correctIndex: 1,
    explanation:
      'One angle greater than 90° makes it obtuse, and two equal angles (42° and 42°) mean two sides are equal, making it isosceles too.',
  },
  {
    id: 'q7',
    type: 'mc',
    concept: 'sideangle',
    prompt:
      'In triangle ABC, angle A = 82°, angle B = 61°, and angle C = 37°. Which side of the triangle is the longest?',
    diagramViewBox: '-8 -8 204 126',
    diagramAlt: 'Triangle A B C drawn to scale with angle A, angle B, and angle C all labeled.',
    diagramSvg: `
      <polygon class="q-shape" points="65.2,18.0 24.0,92.4 164.0,92.4" />
      <path class="q-arc" d="M 56.5 33.7 A 18.0 18.0 0 0 0 79.6 28.8" />
      <path class="q-arc" d="M 42.0 92.4 A 18.0 18.0 0 0 0 32.7 76.7" />
      <path class="q-arc" d="M 149.6 81.6 A 18.0 18.0 0 0 0 146.0 92.4" />
      <text class="q-angle-label" x="72.1" y="50.3">82°</text>
      <text class="q-angle-label" x="52.4" y="75.7">61°</text>
      <text class="q-angle-label" x="132.7" y="81.9">37°</text>
      <circle class="q-pt" cx="65.2" cy="18.0" r="2.6" />
      <circle class="q-pt" cx="24.0" cy="92.4" r="2.6" />
      <circle class="q-pt" cx="164.0" cy="92.4" r="2.6" />
      <text class="q-vertex-label" x="65.2" y="9.0">A</text>
      <text class="q-vertex-label" x="18.0" y="108.4">B</text>
      <text class="q-vertex-label" x="170.0" y="108.4">C</text>
    `,
    options: ['BC (opposite A)', 'AB (opposite C)', 'CA (opposite B)', 'All three sides are equal'],
    correctIndex: 0,
    explanation:
      "In any triangle, the longest side is always opposite the largest angle — here that's the 82° angle at A, so BC is longest.",
  },
  {
    id: 'q8',
    type: 'mc',
    concept: 'parallel',
    prompt:
      'A line through vertex A is drawn parallel to side BC, as shown (matching arrows mark the parallel lines). Angle B = 47°. Using alternate interior angles, what is the measure of the marked angle at A?',
    diagramViewBox: '-8 -8 201 168',
    diagramAlt:
      'Triangle A B C with a dashed line through A parallel to B C, showing angle B and the unknown alternate angle at A.',
    diagramSvg: `
      <polygon class="q-shape" points="128.9,22.0 24.0,134.5 159.0,134.5" />
      <line class="q-dash" x1="94.9" y1="22.0" x2="162.9" y2="22.0" />
      <polyline class="q-chevron" points="85.9,137.7 91.5,134.5 85.9,131.2" />
      <polyline class="q-chevron" points="140.2,25.2 145.9,22.0 140.2,18.8" />
      <path class="q-arc" d="M 37.6 119.8 A 20.0 20.0 0 0 1 44.0 134.5" />
      <path class="q-arc" d="M 110.9 22.0 A 18.0 18.0 0 0 0 116.6 35.2" />
      <text class="q-angle-label" x="56.1" y="120.5">47°</text>
      <text class="q-angle-label" x="98.6" y="35.2">?</text>
      <circle class="q-pt" cx="128.9" cy="22.0" r="2.6" />
      <circle class="q-pt" cx="24.0" cy="134.5" r="2.6" />
      <circle class="q-pt" cx="159.0" cy="134.5" r="2.6" />
      <text class="q-vertex-label" x="133.9" y="13.0">A</text>
      <text class="q-vertex-label" x="18.0" y="150.5">B</text>
      <text class="q-vertex-label" x="165.0" y="150.5">C</text>
    `,
    options: ['47°', '133°', '90°', '43°'],
    correctIndex: 0,
    explanation:
      'Because the dashed line is parallel to BC, AB is a transversal, and alternate interior angles are equal — so the marked angle equals angle B, 47°.',
  },
  {
    id: 'q9',
    type: 'numeric',
    concept: 'exterior',
    prompt:
      'In the triangle below, side BC is extended to point D, creating an exterior angle of 126° at C. If angle A = 55°, what is the measure of angle B?',
    diagramViewBox: '-8 -8 234 173',
    diagramAlt:
      'Triangle A B C with side B C extended to point D, showing angle A, the exterior angle at C, and the unknown angle B.',
    diagramSvg: `
      <polygon class="q-shape" points="65.8,18.0 24.0,139.4 154.0,139.4" />
      <line class="q-ext" x1="154.0" y1="139.4" x2="196.0" y2="139.4" />
      <path class="q-arc" d="M 59.9 35.0 A 18.0 18.0 0 0 0 76.4 32.6" />
      <path class="q-arc" d="M 29.9 122.4 A 18.0 18.0 0 0 1 42.0 139.4" />
      <path class="q-arc" d="M 174.0 139.4 A 20.0 20.0 0 0 0 142.2 123.2" />
      <text class="q-angle-label" x="70.7" y="50.6">55°</text>
      <text class="q-angle-label" x="50.9" y="120.2">?</text>
      <text class="q-angle-label" x="169.9" y="108.2">126°</text>
      <circle class="q-pt" cx="65.8" cy="18.0" r="2.6" />
      <circle class="q-pt" cx="24.0" cy="139.4" r="2.6" />
      <circle class="q-pt" cx="154.0" cy="139.4" r="2.6" />
      <circle class="q-pt" cx="196.0" cy="139.4" r="2.2" />
      <text class="q-vertex-label" x="65.8" y="9.0">A</text>
      <text class="q-vertex-label" x="18.0" y="155.4">B</text>
      <text class="q-vertex-label" x="154.0" y="155.4">C</text>
      <text class="q-vertex-label" x="203.0" y="142.4">D</text>
    `,
    answer: 71,
    tolerance: 0.5,
    explanation:
      'The exterior angle equals the sum of the two remote interior angles, so 126° = 55° + angle B, which makes angle B = 71°.',
  },
];
---

<section class="tq" aria-labelledby="tq-heading">
  <header class="tq-intro">
    <p class="eyebrow">Interactive · Geometry</p>
    <h2 id="tq-heading">The Angles of a Triangle</h2>
    <p class="tq-lede">
      Take this quiz to test your knowledge on the angles of a triangle. Start by dragging the
      triangle below to build your intuition, then put it to the test.
    </p>
  </header>

  <div class="explorer" data-explorer>
    <div class="explorer-head">
      <h3 class="explorer-title">Drag the corners</h3>
      <p class="explorer-hint">
        Drag any vertex — or focus it with Tab and press the arrow keys — to reshape the triangle.
        The three interior angles always add up to 180°.
      </p>
    </div>
    <div class="explorer-body">
      <svg class="tri-svg" viewBox="0 0 400 320" role="img" aria-labelledby="tri-svg-title" data-tri-svg>
        <title id="tri-svg-title">Interactive triangle with three draggable vertices, A, B and C</title>
        <polygon class="tri-shape" data-poly points="" />
        <path class="tri-arc" data-arc />
        <path class="tri-arc" data-arc />
        <path class="tri-arc" data-arc />
        <text class="tri-angle-label" data-angle-label></text>
        <text class="tri-angle-label" data-angle-label></text>
        <text class="tri-angle-label" data-angle-label></text>
        <text class="tri-name-label" data-name-label>A</text>
        <text class="tri-name-label" data-name-label>B</text>
        <text class="tri-name-label" data-name-label>C</text>
        <circle class="tri-dot" data-dot r="6"></circle>
        <circle class="tri-dot" data-dot r="6"></circle>
        <circle class="tri-dot" data-dot r="6"></circle>
        <circle
          class="tri-hit"
          data-hit
          r="22"
          tabindex="0"
          role="button"
          aria-label="Vertex A. Drag, or focus and use arrow keys, to change the triangle."
        ></circle>
        <circle
          class="tri-hit"
          data-hit
          r="22"
          tabindex="0"
          role="button"
          aria-label="Vertex B. Drag, or focus and use arrow keys, to change the triangle."
        ></circle>
        <circle
          class="tri-hit"
          data-hit
          r="22"
          tabindex="0"
          role="button"
          aria-label="Vertex C. Drag, or focus and use arrow keys, to change the triangle."
        ></circle>
      </svg>
      <div class="explorer-readout">
        <div class="angle-chips">
          <div class="angle-chip">
            <span class="angle-chip-value" data-chip>—</span>
            <span class="angle-chip-name">A</span>
          </div>
          <div class="angle-chip">
            <span class="angle-chip-value" data-chip>—</span>
            <span class="angle-chip-name">B</span>
          </div>
          <div class="angle-chip">
            <span class="angle-chip-value" data-chip>—</span>
            <span class="angle-chip-name">C</span>
          </div>
        </div>
        <p class="angle-equation" data-equation>—</p>
        <p class="angle-classification" data-classification>—</p>
      </div>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" data-live></p>
  </div>

  <div class="quiz" data-quiz>
    <div class="quiz-progress">
      <progress class="quiz-progress-bar" data-progress-bar value="1" max={questions.length}></progress>
      <span class="quiz-progress-text" data-progress-text>Question 1 of {questions.length}</span>
    </div>

    <div data-quiz-body>
      {
        questions.map((q, i) => (
          <fieldset
            class="question"
            data-question
            data-type={q.type}
            data-concept={q.concept}
            data-explanation={q.explanation}
            data-answer={q.type === 'numeric' ? String(q.answer) : undefined}
            data-tolerance={q.type === 'numeric' ? String(q.tolerance) : undefined}
            hidden={i !== 0}
          >
            <legend class="question-prompt" id={`${q.id}-prompt`}>
              <span class="question-number">
                Question {i + 1} of {questions.length}
              </span>
              {q.prompt}
            </legend>

            <svg
              class="q-diagram"
              viewBox={q.diagramViewBox}
              role="img"
              aria-label={q.diagramAlt}
              set:html={q.diagramSvg}
            />

            {q.type === 'mc' ? (
              <div class="options" role="radiogroup" aria-labelledby={`${q.id}-prompt`}>
                {q.options.map((opt, oi) => (
                  <label class="option">
                    <input
                      type="radio"
                      name={q.id}
                      value={String(oi)}
                      data-correct={oi === q.correctIndex ? 'true' : 'false'}
                    />
                    <span class="option-text">{opt}</span>
                  </label>
                ))}
              </div>
            ) : (
              <div class="numeric-field">
                <label for={`${q.id}-input`}>Your answer</label>
                <div class="numeric-input-row">
                  <input type="number" inputmode="decimal" step="any" id={`${q.id}-input`} data-numeric-input />
                  <span class="unit" aria-hidden="true">°</span>
                </div>
              </div>
            )}

            <div class="question-actions">
              <button type="button" class="tq-btn btn-check" data-check disabled>
                Check answer
              </button>
              <button type="button" class="tq-btn tq-btn-secondary btn-next" data-next hidden>
                {i === questions.length - 1 ? 'See results' : 'Next question'}
              </button>
            </div>
            <p class="feedback" data-feedback role="status" aria-live="polite" />
          </fieldset>
        ))
      }
    </div>

    <div class="results" data-results hidden>
      <h3>Your results</h3>
      <p class="results-score" data-results-score></p>
      <p class="results-best" data-results-best></p>
      <p class="results-review-heading">Concepts to review</p>
      <ul class="results-review" data-results-review></ul>
      <button type="button" class="tq-btn" data-retry>
        Try again
      </button>
    </div>
  </div>
</section>

<style>
