---
/**
 * PeriodicTable.astro — a self-contained, dependency-free interactive
 * periodic table for thefourcells.
 *
 * Everything (all 118 elements) is inlined below and rendered to static HTML at
 * build time: no fetch, no CDN, no npm data package, no framework runtime.
 * The <script> only attaches behaviour to DOM that already exists.
 *
 * Data notes
 *  - `mass` uses IUPAC standard atomic weights, abridged to 5 significant
 *    figures. Elements with no stable isotope use the bracketed mass number of
 *    the most stable / best-characterised isotope, e.g. `[98]`.
 *  - `en` is Pauling electronegativity; `null` where no value is defined.
 *  - `melt` / `boil` are in kelvin at 1 atm. A few elements sublime (As, and
 *    carbon in practice), so `boil` can sit below `melt`; the temperature view
 *    treats that case as a sublimation point.
 *  - Melting points for 100–103 are estimates; 104–118 have never been prepared
 *    in bulk, so their thermal data and phase are recorded as unknown.
 */

type Category =
  | 'alkali'
  | 'alkaline'
  | 'transition'
  | 'posttransition'
  | 'metalloid'
  | 'nonmetal'
  | 'halogen'
  | 'noble'
  | 'lanthanide'
  | 'actinide';

type Phase = 'solid' | 'liquid' | 'gas' | 'unknown';

interface ChemicalElement {
  /** Atomic number */
  z: number;
  sym: string;
  name: string;
  /** Standard atomic weight, or [mass number] when no stable isotope exists */
  mass: string;
  cat: Category;
  /** IUPAC group 1–18; null for the f-block rows */
  group: number | null;
  period: number;
  /** Ground-state electron configuration, noble-gas abbreviated */
  cfg: string;
  /** Pauling electronegativity */
  en: number | null;
  /** Phase at standard temperature and pressure */
  phase: Phase;
  /** Melting point, K */
  melt: number | null;
  /** Boiling point, K */
  boil: number | null;
  /** Electrons per shell, K→ outwards */
  shells: number[];
  desc: string;
}

