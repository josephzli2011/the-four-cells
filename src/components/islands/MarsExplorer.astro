    --mx-rust-400: #d67a44;
    --mx-dust-200: #efc79a;
    --mx-dust-100: #f7e2c4;
    --mx-ice: #f4f8ff;
    --mx-ice-shadow: #cfd9ea;

    --mx-earth-ocean: #1f5fa8;
    --mx-earth-ocean-deep: #123c6e;
    --mx-earth-land: #3f8f4f;
    --mx-earth-land-dark: #2c6b39;
