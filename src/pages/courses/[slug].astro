---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { courses } from '../../data/site';

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const siblings = courses.filter(
  (c) => c.group === course.group && c.slug !== course.slug
);
---

<Base title={course.title} description={course.blurb}>
  <section class="page-head">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/courses">Courses</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{course.title}</span>
      </nav>

      <div class="head-row">
        <span class="head-icon">
          <Icon name={course.icon} size={30} />
        </span>
        <div>
          <p class="eyebrow">{course.group}</p>
          <h1>{course.title}</h1>
        </div>
      </div>
      <p class="lede">{course.blurb}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        course.lessons.length > 0 ? (
          <>
            <h2 class="sec-title">Lessons</h2>
            <div class="grid">
              {course.lessons.map((lesson, i) => (
                <div data-reveal style={`--reveal-delay:${Math.min(i * 70, 150)}ms`}>
                  <ResourceCard
                    href={`/courses/${course.slug}/${lesson.slug}`}
                    title={lesson.title}
                    blurb={lesson.blurb}
                    tag={lesson.kind}
                    cta={lesson.kind === 'Quiz' ? 'Take Quiz' : 'Learn More'}
                    seed={`${course.slug}-${lesson.slug}`}
                  />
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="empty" data-reveal>
            <span class="empty-icon">
              <Icon name={course.icon} size={28} />
            </span>
            <h2>Lessons are on the way</h2>
            <p>
              We're building out {course.title.toLowerCase()} now. In the meantime, try one
              of the interactive modules that are already live — or help us get here faster
              by contributing a lesson of your own.
            </p>
            <div class="empty-actions">
              <a href="/submit" class="btn">
                Contribute a lesson
                <Icon name="arrow" size={17} class="btn-arrow" />
              </a>
              <a href="/courses" class="btn btn-secondary">Browse other subjects</a>
            </div>
          </div>
        )
      }

      {
        siblings.length > 0 && (
          <div class="siblings">
            <h2 class="sec-title">More in {course.group}</h2>
            <ul role="list" class="sib-list">
              {siblings.map((c) => (
                <li>
                  <a href={`/courses/${c.slug}`}>
                    <Icon name={c.icon} size={18} />
                    {c.title}
                    <Icon name="arrow" size={15} class="btn-arrow" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(2rem, 5vw, 3.5rem) 0; }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-faint);
    margin-bottom: var(--sp-5);
  }

  .crumbs a {
    display: inline-block;
    padding-block: 3px;
    color: var(--text-muted);
    text-decoration: none;
  }
  .crumbs a:hover { color: var(--accent); text-decoration: underline; }

  .head-row {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  .head-icon {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    border-radius: var(--r-lg);
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .head-row h1 {
    font-size: var(--fs-3xl);
    font-weight: 500;
    margin-top: var(--sp-1);
  }

  .lede {
    max-width: 62ch;
    font-size: var(--fs-lg);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .sec-title {
    font-size: var(--fs-xl);
    font-weight: 500;
    margin-bottom: var(--sp-5);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--border);
  }

  .grid {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: var(--sp-4);
    max-width: 60ch;
    padding: var(--sp-7);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-lg);
    background: var(--bg-subtle);
  }

  .empty-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--accent);
    border: 1px solid var(--border);
  }

  .empty h2 { font-size: var(--fs-xl); font-weight: 500; }
  .empty p { color: var(--text-muted); line-height: 1.7; }

  .empty-actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }

  .siblings { margin-top: var(--sp-8); }

  .sib-list {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  }

  .sib-list a {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-sm);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .sib-list a:hover { border-color: var(--accent); color: var(--accent); }
  .sib-list :global(.btn-arrow) {
    margin-left: auto;
    transition: transform var(--dur) var(--ease);
  }
  .sib-list a:hover :global(.btn-arrow) { transform: translateX(3px); }
</style>
