    font-weight: 700;
    color: var(--accent);
  }

  .mx-entry-agency {
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .mx-entry-mission {
    font-size: var(--fs-base);
    font-weight: 500;
  }

  .mx-entry-blurb {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ---- Credit -----------------------------------------------------------*/
  .mx-credit {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    max-width: 70ch;
  }
</style>

<script>
  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  // ---- Globe hotspots: caption-style tooltip, announced via aria-live --
  const tipEl = document.querySelector<HTMLParagraphElement>('[data-mx-tip]');
  const tipDefaultText = tipEl?.textContent ?? '';
  const hotspotButtons = document.querySelectorAll<HTMLButtonElement>('[data-mx-hotspot]');

  hotspotButtons.forEach((btn) => {
    const label = btn.dataset.label ?? '';
    const fact = btn.dataset.fact ?? '';

    const show = () => {
      if (tipEl) tipEl.textContent = `${label}: ${fact}`;
    };
    const hide = () => {
      if (tipEl) tipEl.textContent = tipDefaultText;
    };

    btn.addEventListener('mouseenter', show);
    btn.addEventListener('focus', show);
    btn.addEventListener('mouseleave', hide);
    btn.addEventListener('blur', hide);
  });

  // ---- Earth ⇄ Mars comparison slider -----------------------------------
  const slider = document.querySelector<HTMLInputElement>('[data-mx-slider]');
  const panels = document.querySelectorAll<HTMLElement>('[data-mx-panel]');

  function renderPanel(index: number): void {
    panels.forEach((panel, i) => {
      panel.hidden = i !== index;
    });
    const active = panels[index];
    if (slider && active) {
      slider.setAttribute('aria-valuetext', active.dataset.metricName ?? '');
    }
  }

  if (slider) {
    slider.addEventListener('input', () => {
      renderPanel(Number(slider.value) || 0);
    });
  }

  // ---- Weight on Mars calculator -----------------------------------------
  const MARS_GRAVITY_RATIO = 0.3794;
  const weightInput = document.querySelector<HTMLInputElement>('[data-mx-weight-input]');
  const weightResult = document.querySelector<HTMLParagraphElement>('[data-mx-weight-result]');
  const unitButtons = document.querySelectorAll<HTMLButtonElement>('[data-mx-unit]');
  let currentUnit: 'kg' | 'lb' = 'kg';

  function formatNumber(n: number): string {
    return n >= 100 ? n.toFixed(0) : n.toFixed(1);
  }

  function updateWeight(): void {
    if (!weightInput || !weightResult) return;
    const raw = weightInput.value.trim();
    const value = parseFloat(raw);

    if (raw === '' || Number.isNaN(value) || !Number.isFinite(value) || value <= 0) {
      weightResult.textContent = 'Enter a positive weight above to see what it would be on Mars.';
      return;
    }

    const converted = value * MARS_GRAVITY_RATIO;
    weightResult.textContent =
      `${formatNumber(value)} ${currentUnit} on Earth ≈ ${formatNumber(converted)} ${currentUnit} on Mars ` +
      `(Mars's surface gravity is about 38% of Earth's).`;
  }

  unitButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentUnit = btn.dataset.mxUnit === 'lb' ? 'lb' : 'kg';
      unitButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      if (weightInput) weightInput.setAttribute('aria-label', `Your weight in ${currentUnit}`);
      updateWeight();
    });
  });

  weightInput?.addEventListener('input', updateWeight);

  // ---- Mission timeline: arrow-key navigation ----------------------------
  const timeline = document.querySelector<HTMLElement>('[data-mx-timeline]');
  const entries = timeline
    ? Array.from(timeline.querySelectorAll<HTMLButtonElement>('[data-mx-entry]'))
    : [];

  entries.forEach((entry, i) => {
    entry.addEventListener('keydown', (event: KeyboardEvent) => {
      let target: HTMLButtonElement | undefined;
      if (event.key === 'ArrowRight') target = entries[i + 1];
      else if (event.key === 'ArrowLeft') target = entries[i - 1];
      else if (event.key === 'Home') target = entries[0];
      else if (event.key === 'End') target = entries[entries.length - 1];

      if (target) {
        event.preventDefault();
        target.focus();
        target.scrollIntoView({
          behavior: prefersReducedMotion() ? 'auto' : 'smooth',
          inline: 'center',
          block: 'nearest',
        });
      }
    });
  });
</script>
