    font-size: var(--fs-base);
  }

  /* ---- Timeline -------------------------------------------------------*/
  .mx-timeline {
    display: flex;
    gap: var(--sp-4);
    overflow-x: auto;
    padding-block: var(--sp-2) var(--sp-4);
